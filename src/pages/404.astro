---
import Layout from "../layouts/Layout.astro";
import { type Locale } from "../config/site";
import { localePath } from "../utils/i18n";

const locale = (Astro.currentLocale || 'en') as Locale;
const homePath = localePath('/', locale);
---

<Layout title="Page Not Found" description="The page you're looking for doesn't exist." hideStatsBanner={true}>
  <section class="relative py-32 lg:py-48 overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute top-1/4 left-1/3 w-[300px] h-[200px] md:w-[600px] md:h-[400px] bg-[radial-gradient(circle,rgba(161,99,241,0.06)_0%,transparent_70%)]"></div>
      <div class="absolute bottom-1/4 right-1/4 w-[200px] h-[200px] md:w-[400px] md:h-[400px] bg-[radial-gradient(circle,rgba(35,240,195,0.04)_0%,transparent_70%)]"></div>
    </div>

    <div class="relative max-w-3xl mx-auto px-6 lg:px-8 text-center">
      <div class="heading-xl text-8xl lg:text-9xl gradient-text mb-6 animate-fade-in-up opacity-0" style="animation-delay: 0.1s; animation-fill-mode: forwards;">
        404
      </div>
      <h1 class="heading-lg text-3xl lg:text-4xl text-off-white mb-4 animate-fade-in-up opacity-0" style="animation-delay: 0.2s; animation-fill-mode: forwards;">
        Page Not Found
      </h1>
      <p class="text-lg text-text-secondary mb-10 animate-fade-in-up opacity-0" style="animation-delay: 0.3s; animation-fill-mode: forwards;">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="animate-fade-in-up opacity-0" style="animation-delay: 0.4s; animation-fill-mode: forwards;">
        <a href={homePath} class="btn-primary">Back to Home</a>
      </div>
    </div>
  </section>
</Layout>
