---
// Section header styled as the title block (Schriftfeld) of an
// engineering drawing — sheet number, section name, author, scale.
import type { Locale } from "../config/site";

interface Props {
  no: string;
  title: string;
  locale?: Locale;
}

const { no, title } = Astro.props;
const locale = (Astro.props.locale || 'en') as Locale;
const L = locale === 'de'
  ? { sheet: 'Blatt', drawn: 'Gez.', scale: 'Maßstab' }
  : { sheet: 'Sheet', drawn: 'Drawn', scale: 'Scale' };
---

<div class="flex items-stretch border border-ink bg-paper font-mono text-[0.6875rem] uppercase tracking-[0.08em] text-graphite">
  <span class="px-3 py-2 border-r border-ink bg-ink text-paper font-medium whitespace-nowrap">{L.sheet} {no}</span>
  <span class="px-3 py-2 flex-1 text-ink font-medium truncate">{title}</span>
  <span class="hidden sm:flex items-center px-3 py-2 border-l border-ink/30 whitespace-nowrap">{L.drawn}: G.W.</span>
  <span class="hidden md:flex items-center px-3 py-2 border-l border-ink/30 whitespace-nowrap">{L.scale} 1:1</span>
  <span class="hidden md:flex items-center px-3 border-l border-ink/30" aria-hidden="true">
    <span class="w-1.5 h-1.5 rounded-full bg-rubric"></span>
  </span>
</div>
