---
import "../styles/global.css";
import { t, type Locale } from "../config/site";
import { getHreflangAlternates, localePath } from "../utils/i18n";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import ChatWidget from "../components/ChatWidget.astro";
import RemixToggle from "../components/RemixToggle.astro";
import TranslationToggle from "../components/TranslationToggle.astro";
import AiToolsMenu from "../components/AiToolsMenu.astro";

interface Props {
  title?: string;
  description?: string;
  hideStatsBanner?: boolean;
  locale?: Locale;
}

const { title, description, hideStatsBanner = false, locale: propLocale } = Astro.props;
const locale = (propLocale || Astro.currentLocale || 'en') as Locale;
const config = t(locale);
const pageTitle = title ? `${title} | ${config.name}` : `${config.name} — ${config.tagline}`;
const pageDescription = description || config.description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://creative-it.com').href;

const hreflangAlternates = getHreflangAlternates(Astro.url.pathname);
const ogLocale = locale === 'de' ? 'de_AT' : 'en_US';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://creative-it.com/#organization",
  name: "creative-it Software Consulting e.U.",
  description: config.description,
  url: "https://creative-it.com",
  logo: "https://creative-it.com/favicon.png",
  telephone: config.contact.phone,
  email: config.contact.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Am Gassl 25",
    addressLocality: "Gösing am Wagram",
    postalCode: "3482",
    addressCountry: "AT",
  },
  sameAs: [
    config.social.linkedin,
    config.social.twitter,
    config.social.github,
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#F7F4EF" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />

    {hreflangAlternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={new URL(alt.href, Astro.site || 'https://creative-it.com').href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site || 'https://creative-it.com').href} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={config.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site || 'https://creative-it.com').href} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-navy text-off-white">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-ink focus:text-paper focus:rounded-sm focus:text-sm focus:font-medium">Skip to content</a>

    <Navigation locale={locale} />
    <main id="main-content" class="flex-1 relative z-10">
      <slot />
    </main>
    <Footer locale={locale} />
    <ChatWidget locale={locale} />
    <RemixToggle locale={locale} />
    <TranslationToggle locale={locale} />

    <!-- AI Tools Parent Button -->
    <button
      id="ai-tools-toggle"
      class="fixed left-6 z-50 w-14 h-14 rounded-full bg-ink shadow-[0_4px_24px_rgba(28,27,26,0.15)] flex items-center justify-center cursor-pointer hover:shadow-[0_4px_32px_rgba(28,27,26,0.15)] transition-[transform,box-shadow] duration-300"
      style="bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px)); -webkit-backface-visibility: hidden"
      aria-label="AI Tools"
      title="AI-Demo-Tools ausprobieren"
    >
      <!-- AI sparkles icon -->
      <svg id="ai-tools-icon" class="w-6 h-6 text-white transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
      </svg>
      <!-- Close icon -->
      <svg id="ai-tools-close-icon" class="hidden w-6 h-6 text-white transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Labels that appear next to sub-buttons (base position matches main toggle; JS translates them) -->
    <span id="ai-label-chat" class="fixed left-6 z-50 text-xs text-text-muted bg-surface/90 border border-ink/[0.06] rounded-lg px-2.5 py-1 shadow-lg backdrop-blur-sm opacity-0 pointer-events-none transition-[transform,opacity] duration-300" style="bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px))">
      {config.chatWidget.buttonLabel}
    </span>
    <span id="ai-label-remix" class="fixed left-6 z-50 text-xs text-text-muted bg-surface/90 border border-ink/[0.06] rounded-lg px-2.5 py-1 shadow-lg backdrop-blur-sm opacity-0 pointer-events-none transition-[transform,opacity] duration-300" style="bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px))">
      {config.remix.buttonLabel}
    </span>
    <span id="ai-label-translate" class="fixed left-6 z-50 text-xs text-text-muted bg-surface/90 border border-ink/[0.06] rounded-lg px-2.5 py-1 shadow-lg backdrop-blur-sm opacity-0 pointer-events-none transition-[transform,opacity] duration-300" style="bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px))">
      {config.translation.buttonLabel}
    </span>

    <AiToolsMenu />

    <script>
      import '../scripts/contact-protect';
    </script>
    {!hideStatsBanner && (
      <!-- Collapsible GitHub Stats Banner -->
      <div id="github-stats-wrapper" class="hidden fixed right-0 z-50 flex items-end" style="bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px))" data-i18n-commits={config.statsBanner.commits} data-i18n-lines={config.statsBanner.lines}>
        <!-- Expanded card -->
        <div id="github-stats-banner" class="mr-6 transition-all duration-400 ease-in-out origin-right">
          <div class="relative">
            <!-- Close / collapse button -->
            <button
              id="github-stats-close"
              class="absolute -top-3 -right-3 w-10 h-10 bg-surface border border-ink/[0.08] rounded-full flex items-center justify-center text-text-muted hover:text-off-white hover:border-purple/30 transition-colors duration-200 cursor-pointer z-10"
              aria-label={config.statsBanner.collapseLabel}
              title={config.statsBanner.collapseLabel}
            >
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
            <a href={localePath("/agentic-coding", locale)} class="group block bg-surface border border-ink/[0.06] rounded-2xl px-5 py-4 shadow-[0_8px_32px_rgba(0,0,0,0.12)] backdrop-blur-sm max-w-xs hover:border-purple/30 transition-colors duration-300">
              <div class="flex items-center gap-2.5 mb-3">
                <svg class="w-5 h-5 text-purple flex-shrink-0" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
                </svg>
                <span class="text-xs text-text-muted leading-tight">{config.statsBanner.description}</span>
              </div>
              <div class="space-y-1.5 text-sm">
                <div class="flex items-center justify-between">
                  <span class="text-text-muted">{config.statsBanner.last24h}</span>
                  <span id="stats-24h" class="text-text-secondary font-medium"></span>
                </div>
                <div class="w-full h-px bg-ink/[0.04]"></div>
                <div class="flex items-center justify-between">
                  <span class="text-text-muted">{config.statsBanner.last7d}</span>
                  <span id="stats-7d" class="text-text-secondary font-medium"></span>
                </div>
              </div>
              <div class="mt-3 pt-3 border-t border-ink/[0.04] flex items-center justify-center gap-1.5 text-xs text-indigo group-hover:text-purple transition-colors duration-300">
                <span>{config.statsBanner.learnMore}</span>
                <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
              </div>
            </a>
          </div>
        </div>

        <!-- Collapsed toggle button (AI icon) -->
        <button
          id="github-stats-toggle"
          class="hidden flex items-center justify-center w-12 h-12 bg-surface border border-ink/[0.06] border-r-0 rounded-l-xl shadow-[0_8px_32px_rgba(0,0,0,0.12)] backdrop-blur-sm hover:border-purple/30 transition-all duration-300 cursor-pointer group"
          aria-label={config.statsBanner.expandLabel}
          title={config.statsBanner.expandLabel}
        >
          <!-- Stylized AI / neural network icon -->
          <svg class="w-6 h-6 text-purple group-hover:text-cyan transition-colors duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <!-- Central brain node -->
            <circle cx="12" cy="12" r="2.5" fill="currentColor" stroke="none" />
            <!-- Outer orbit nodes -->
            <circle cx="12" cy="4" r="1.5" fill="currentColor" stroke="none" opacity="0.7" />
            <circle cx="19" cy="8" r="1.5" fill="currentColor" stroke="none" opacity="0.7" />
            <circle cx="19" cy="16" r="1.5" fill="currentColor" stroke="none" opacity="0.7" />
            <circle cx="12" cy="20" r="1.5" fill="currentColor" stroke="none" opacity="0.7" />
            <circle cx="5" cy="16" r="1.5" fill="currentColor" stroke="none" opacity="0.7" />
            <circle cx="5" cy="8" r="1.5" fill="currentColor" stroke="none" opacity="0.7" />
            <!-- Connection lines -->
            <line x1="12" y1="9.5" x2="12" y2="5.5" stroke="currentColor" stroke-width="1" opacity="0.4" />
            <line x1="14.2" y1="10.3" x2="17.7" y2="8.8" stroke="currentColor" stroke-width="1" opacity="0.4" />
            <line x1="14.2" y1="13.7" x2="17.7" y2="15.2" stroke="currentColor" stroke-width="1" opacity="0.4" />
            <line x1="12" y1="14.5" x2="12" y2="18.5" stroke="currentColor" stroke-width="1" opacity="0.4" />
            <line x1="9.8" y1="13.7" x2="6.3" y2="15.2" stroke="currentColor" stroke-width="1" opacity="0.4" />
            <line x1="9.8" y1="10.3" x2="6.3" y2="8.8" stroke="currentColor" stroke-width="1" opacity="0.4" />
          </svg>
        </button>
      </div>

      <script>
        function formatNumber(n: number): string {
          if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1).replace(/\.0$/, '')}M`;
          if (n >= 1_000) return `${(n / 1_000).toFixed(1).replace(/\.0$/, '')}k`;
          return n.toString();
        }

        const STORAGE_KEY = 'github-stats-collapsed';

        function isCollapsed(): boolean {
          try { return localStorage.getItem(STORAGE_KEY) === '1'; } catch { return false; }
        }

        function setCollapsed(collapsed: boolean): void {
          try { localStorage.setItem(STORAGE_KEY, collapsed ? '1' : '0'); } catch {}
        }

        function applyState(collapsed: boolean): void {
          const banner = document.getElementById('github-stats-banner');
          const toggle = document.getElementById('github-stats-toggle');
          if (!banner || !toggle) return;

          if (collapsed) {
            banner.style.transform = 'translateX(calc(100% + 24px))';
            banner.style.opacity = '0';
            banner.style.pointerEvents = 'none';
            toggle.classList.remove('hidden');
            toggle.classList.add('flex');
          } else {
            banner.style.transform = 'translateX(0)';
            banner.style.opacity = '1';
            banner.style.pointerEvents = 'auto';
            toggle.classList.add('hidden');
            toggle.classList.remove('flex');
          }
        }

        (async () => {
          try {
            const res = await fetch(`${import.meta.env.PUBLIC_API_URL}/github-stats`, { cache: 'no-store' });
            if (!res.ok) return;

            const data = await res.json();
            if (data.commits_7d === 0 && data.commits_24h === 0) return;

            const el24h = document.getElementById('stats-24h');
            const el7d = document.getElementById('stats-7d');
            const wrapper = document.getElementById('github-stats-wrapper');
            const banner = document.getElementById('github-stats-banner');
            const toggle = document.getElementById('github-stats-toggle');
            const closeBtn = document.getElementById('github-stats-close');
            if (!el24h || !el7d || !wrapper || !banner || !toggle || !closeBtn) return;

            const commitsLabel = wrapper.dataset.i18nCommits || 'commits';
            const linesLabel = wrapper.dataset.i18nLines || 'lines';
            el24h.textContent = `${formatNumber(data.commits_24h)} ${commitsLabel} · ${formatNumber(data.lines_24h)} ${linesLabel}`;
            el7d.textContent = `${formatNumber(data.commits_7d)} ${commitsLabel} · ${formatNumber(data.lines_7d)} ${linesLabel}`;

            // Set initial transition style
            banner.style.transition = 'transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease';

            // Apply saved state before showing
            const collapsed = isCollapsed();
            if (collapsed) {
              banner.style.transform = 'translateX(calc(100% + 24px))';
              banner.style.opacity = '0';
              banner.style.pointerEvents = 'none';
              toggle.classList.remove('hidden');
              toggle.classList.add('flex');
            }

            // Show wrapper with fade-in
            wrapper.classList.remove('hidden');
            wrapper.classList.add('flex');
            wrapper.style.opacity = '0';
            wrapper.style.transition = 'opacity 0.5s ease';
            requestAnimationFrame(() => { wrapper.style.opacity = '1'; });

            // Close button: collapse the card
            closeBtn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              setCollapsed(true);
              applyState(true);
            });

            // Toggle button: expand the card
            toggle.addEventListener('click', () => {
              setCollapsed(false);
              applyState(false);
            });
          } catch {
            // Banner stays hidden on error
          }
        })();
      </script>
    )}
  </body>
</html>
