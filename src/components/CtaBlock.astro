---
// The single ink block per page — the "blueprint moment": dark panel with
// a faint light grid (the negative of the drafting paper) and corner marks.
interface Props {
  headline: string;
  description: string;
  button: string;
  href: string;
}

const { headline, description, button, href } = Astro.props;
---

<section class="py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div
      class="bg-ink relative px-8 py-14 lg:px-16 lg:py-20"
      style="background-image: linear-gradient(to right, rgba(247,244,239,0.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(247,244,239,0.06) 1px, transparent 1px); background-size: 40px 40px;"
    >
      <!-- Registration-mark corners -->
      <span class="absolute top-3 left-3 w-4 h-4 border-t border-l border-paper/40" aria-hidden="true"></span>
      <span class="absolute top-3 right-3 w-4 h-4 border-t border-r border-paper/40" aria-hidden="true"></span>
      <span class="absolute bottom-3 left-3 w-4 h-4 border-b border-l border-paper/40" aria-hidden="true"></span>
      <span class="absolute bottom-3 right-3 w-4 h-4 border-b border-r border-paper/40" aria-hidden="true"></span>

      <div class="max-w-3xl">
        <h2 class="heading-xl text-4xl lg:text-5xl text-paper mb-5 whitespace-pre-line">{headline}</h2>
        <p class="text-paper/70 text-lg mb-10">{description}</p>
        <a href={href} class="btn-primary">{button}</a>
        <slot />
      </div>
    </div>
  </div>
</section>
