---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../config/site";
---

<Layout title="Contact" description="Get in touch with creative-it to discuss your project">
  <!-- Hero -->
  <section class="relative py-20 lg:py-32 overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-gradient-to-br from-mint/5 via-transparent to-light-blue/5"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="subheadline text-mint mb-4 block animate-fade-in-up opacity-0" style="animation-delay: 0.1s; animation-fill-mode: forwards;">Contact Us</span>
        <h1 class="headline text-5xl lg:text-6xl xl:text-7xl text-off-white mb-6 animate-fade-in-up opacity-0" style="animation-delay: 0.2s; animation-fill-mode: forwards;">
          Let's Start <span class="gradient-text">Building</span>
        </h1>
        <p class="text-xl text-off-white/60 leading-relaxed animate-fade-in-up opacity-0" style="animation-delay: 0.3s; animation-fill-mode: forwards;">
          Have a project in mind? We'd love to hear about it. Reach out and let's discuss how we can help you achieve your goals.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Content -->
  <section class="py-12 lg:py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-20">
        <!-- Contact Info -->
        <div class="lg:col-span-5 reveal">
          <h2 class="headline text-2xl text-off-white mb-8">Get in Touch</h2>

          <div class="space-y-8 mb-12">
            <!-- Email -->
            <a
              href={`mailto:${siteConfig.contact.email}`}
              class="group flex items-start gap-4 p-4 -m-4 rounded-xl hover:bg-white/5 transition-colors duration-300"
            >
              <div class="w-14 h-14 rounded-xl bg-mint/10 flex items-center justify-center flex-shrink-0 group-hover:bg-mint/20 transition-colors duration-300">
                <svg class="w-6 h-6 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <div class="subheadline text-off-white/50 text-xs mb-1">Email</div>
                <div class="text-off-white group-hover:text-mint transition-colors duration-300">{siteConfig.contact.email}</div>
              </div>
            </a>

            <!-- Phone -->
            <a
              href={`tel:${siteConfig.contact.phone}`}
              class="group flex items-start gap-4 p-4 -m-4 rounded-xl hover:bg-white/5 transition-colors duration-300"
            >
              <div class="w-14 h-14 rounded-xl bg-mint/10 flex items-center justify-center flex-shrink-0 group-hover:bg-mint/20 transition-colors duration-300">
                <svg class="w-6 h-6 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <div class="subheadline text-off-white/50 text-xs mb-1">Phone</div>
                <div class="text-off-white group-hover:text-mint transition-colors duration-300">{siteConfig.contact.phone}</div>
              </div>
            </a>

            <!-- Address -->
            <div class="flex items-start gap-4 p-4 -m-4">
              <div class="w-14 h-14 rounded-xl bg-mint/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <div class="subheadline text-off-white/50 text-xs mb-1">Address</div>
                <div class="text-off-white">{siteConfig.contact.address}</div>
              </div>
            </div>
          </div>

          <!-- Social Links -->
          <div>
            <h3 class="subheadline text-off-white/50 text-xs mb-4">Follow Us</h3>
            <div class="flex gap-3">
              <a
                href={siteConfig.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="w-12 h-12 rounded-xl bg-midnight-light flex items-center justify-center text-off-white/60 hover:bg-mint hover:text-midnight transition-all duration-300"
                aria-label="LinkedIn"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              </a>
              <a
                href={siteConfig.social.twitter}
                target="_blank"
                rel="noopener noreferrer"
                class="w-12 h-12 rounded-xl bg-midnight-light flex items-center justify-center text-off-white/60 hover:bg-mint hover:text-midnight transition-all duration-300"
                aria-label="Twitter"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
              <a
                href={siteConfig.social.github}
                target="_blank"
                rel="noopener noreferrer"
                class="w-12 h-12 rounded-xl bg-midnight-light flex items-center justify-center text-off-white/60 hover:bg-mint hover:text-midnight transition-all duration-300"
                aria-label="GitHub"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="lg:col-span-7 reveal" style="transition-delay: 200ms">
          <div class="bg-dark-grey rounded-2xl p-8 lg:p-12 border border-white/5">
            <h2 class="headline text-2xl text-off-white mb-2">Send a Message</h2>
            <p class="text-off-white/50 mb-8">Fill out the form below and we'll get back to you shortly.</p>

            <form class="space-y-6" id="contact-form">
              <div class="grid sm:grid-cols-2 gap-6">
                <div>
                  <label for="name" class="block text-sm font-medium text-off-white/70 mb-2">Name</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    class="w-full px-4 py-3 bg-midnight border border-white/10 rounded-xl text-off-white placeholder-off-white/30 focus:border-mint focus:ring-1 focus:ring-mint transition-all duration-300"
                    placeholder="Your name"
                  />
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium text-off-white/70 mb-2">Email</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    class="w-full px-4 py-3 bg-midnight border border-white/10 rounded-xl text-off-white placeholder-off-white/30 focus:border-mint focus:ring-1 focus:ring-mint transition-all duration-300"
                    placeholder="your@email.com"
                  />
                </div>
              </div>

              <div>
                <label for="company" class="block text-sm font-medium text-off-white/70 mb-2">Company <span class="text-off-white/30">(optional)</span></label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  class="w-full px-4 py-3 bg-midnight border border-white/10 rounded-xl text-off-white placeholder-off-white/30 focus:border-mint focus:ring-1 focus:ring-mint transition-all duration-300"
                  placeholder="Your company"
                />
              </div>

              <div>
                <label for="subject" class="block text-sm font-medium text-off-white/70 mb-2">Subject</label>
                <select
                  id="subject"
                  name="subject"
                  required
                  class="w-full px-4 py-3 bg-midnight border border-white/10 rounded-xl text-off-white focus:border-mint focus:ring-1 focus:ring-mint transition-all duration-300"
                >
                  <option value="" class="text-off-white/30">Select a topic</option>
                  <option value="project">New Project</option>
                  <option value="consulting">Consulting Inquiry</option>
                  <option value="partnership">Partnership Opportunity</option>
                  <option value="careers">Careers</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-off-white/70 mb-2">Message</label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  required
                  class="w-full px-4 py-3 bg-midnight border border-white/10 rounded-xl text-off-white placeholder-off-white/30 focus:border-mint focus:ring-1 focus:ring-mint transition-all duration-300 resize-none"
                  placeholder="Tell us about your project or inquiry..."
                ></textarea>
              </div>

              <button
                type="submit"
                class="btn-primary w-full sm:w-auto"
              >
                <span>Send Message</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 lg:py-32 bg-dark-grey">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-16 reveal">
        <span class="subheadline text-mint mb-4 block">FAQ</span>
        <h2 class="headline text-4xl lg:text-5xl text-off-white">
          Common Questions
        </h2>
      </div>

      <div class="space-y-4 reveal">
        {[
          {
            question: "What types of projects do you work on?",
            answer: "We work on a wide range of technology projects including custom software development, cloud architecture, digital transformation initiatives, and IT consulting. From startups to enterprises, we tailor our approach to meet your specific needs."
          },
          {
            question: "How do you handle project communication?",
            answer: "We believe in transparent, consistent communication. You'll have a dedicated point of contact, regular status updates, and access to project management tools. We adapt our communication style to what works best for your team."
          },
          {
            question: "What's your typical project timeline?",
            answer: "Timelines vary based on project scope and complexity. During our initial consultation, we'll provide a detailed timeline estimate. We focus on delivering quality work efficiently, keeping you informed of progress throughout."
          },
          {
            question: "Do you offer ongoing support after project completion?",
            answer: "Absolutely. We offer various support and maintenance packages to ensure your solutions continue to perform optimally. We're committed to your long-term success, not just project delivery."
          },
        ].map((item, index) => (
          <div
            class="group border border-white/5 rounded-xl overflow-hidden hover:border-mint/20 transition-colors duration-300"
            style={`transition-delay: ${index * 50}ms`}
          >
            <button
              class="faq-trigger w-full flex items-center justify-between p-6 text-left"
              aria-expanded="false"
            >
              <span class="headline text-lg text-off-white group-hover:text-mint transition-colors duration-300">{item.question}</span>
              <svg class="faq-icon w-5 h-5 text-mint flex-shrink-0 ml-4 transform transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="faq-content hidden px-6 pb-6">
              <p class="text-off-white/60 leading-relaxed">{item.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  // FAQ Accordion
  document.querySelectorAll('.faq-trigger').forEach(button => {
    button.addEventListener('click', () => {
      const content = button.nextElementSibling as HTMLElement;
      const icon = button.querySelector('.faq-icon') as HTMLElement;
      const isExpanded = button.getAttribute('aria-expanded') === 'true';

      // Close all other FAQs
      document.querySelectorAll('.faq-trigger').forEach(otherButton => {
        if (otherButton !== button) {
          otherButton.setAttribute('aria-expanded', 'false');
          const otherContent = otherButton.nextElementSibling as HTMLElement;
          const otherIcon = otherButton.querySelector('.faq-icon') as HTMLElement;
          otherContent?.classList.add('hidden');
          otherIcon?.classList.remove('rotate-180');
        }
      });

      // Toggle current FAQ
      button.setAttribute('aria-expanded', (!isExpanded).toString());
      content?.classList.toggle('hidden');
      icon?.classList.toggle('rotate-180');
    });
  });

  // Form submission (placeholder)
  document.getElementById('contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    // Add your form submission logic here
    alert('Thank you for your message! We\'ll be in touch soon.');
  });
</script>
