---
import { t, type Locale } from "../config/site";
import { localePath } from "../utils/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale || (Astro.currentLocale as Locale) || 'en';
const config = t(locale);
const emailEncoded = btoa(config.contact.email);
const phoneEncoded = btoa(config.contact.phone);

const navLabel = locale === 'de' ? 'Navigation' : 'Navigation';
const servicesLabel = locale === 'de' ? 'Dienstleistungen' : 'Services';
const contactLabel = locale === 'de' ? 'Kontakt' : 'Contact';
const legalLabel = locale === 'de' ? 'Impressum' : 'Legal Notice';
const privacyLabel = locale === 'de' ? 'Datenschutz' : 'Privacy Policy';
const rightsLabel = locale === 'de' ? 'Alle Rechte vorbehalten.' : 'All rights reserved.';
const colophon = locale === 'de'
  ? 'Gesetzt in Barlow Condensed & IBM Plex. Kein Tracking.'
  : 'Set in Barlow Condensed & IBM Plex. No tracking.';
const tb = locale === 'de'
  ? { project: 'Projekt', drawn: 'Gezeichnet', loc: 'Ort', sheet: 'Blatt' }
  : { project: 'Project', drawn: 'Drawn by', loc: 'Location', sheet: 'Sheet' };
---

<footer class="border-t border-rule">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16 lg:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8">
      <!-- Brand Column -->
      <div class="lg:col-span-5">
        <a href={localePath('/', locale)} class="inline-flex items-center gap-2.5 mb-5">
          <img
            src="/logo-only.webp"
            alt=""
            width="504"
            height="548"
            loading="lazy"
            decoding="async"
            class="h-8 w-auto"
          />
          <span class="font-serif text-xl text-ink tracking-tight">creative-it<span class="text-rubric">.</span></span>
        </a>
        <p class="text-graphite text-sm leading-relaxed max-w-sm mb-8">
          {config.description}
        </p>

        <!-- Social Links -->
        <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.08em]">
          <a
            href={config.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="text-graphite hover:text-ink underline-offset-4 hover:underline transition-colors duration-150"
          >LinkedIn</a>
          <span class="text-rule" aria-hidden="true">·</span>
          <a
            href={config.social.twitter}
            target="_blank"
            rel="noopener noreferrer"
            class="text-graphite hover:text-ink underline-offset-4 hover:underline transition-colors duration-150"
          >X</a>
          <span class="text-rule" aria-hidden="true">·</span>
          <a
            href={config.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-graphite hover:text-ink underline-offset-4 hover:underline transition-colors duration-150"
          >GitHub</a>
        </div>
      </div>

      <!-- Navigation -->
      <div class="lg:col-span-2">
        <h4 class="label mb-5">{navLabel}</h4>
        <ul class="space-y-2.5">
          {config.navigation.flatMap((item) =>
            item.children
              ? item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class="text-graphite hover:text-ink transition-colors duration-150 text-sm"
                    >
                      {child.name}
                    </a>
                  </li>
                ))
              : (
                  <li>
                    <a
                      href={item.href}
                      class="text-graphite hover:text-ink transition-colors duration-150 text-sm"
                    >
                      {item.name}
                    </a>
                  </li>
                )
          )}
        </ul>
      </div>

      <!-- Services -->
      <div class="lg:col-span-2">
        <h4 class="label mb-5">{servicesLabel}</h4>
        <ul class="space-y-2.5">
          {config.services.map((service) => (
            <li>
              <a
                href={`${localePath('/services', locale)}#${service.title.toLowerCase().replace(/[\s-]+/g, '-').replace(/[^a-z0-9-]/g, '')}`}
                class="text-graphite hover:text-ink transition-colors duration-150 text-sm"
              >
                {service.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div class="lg:col-span-3">
        <h4 class="label mb-5">{contactLabel}</h4>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a
              data-ct={emailEncoded}
              data-ct-type="email"
              class="text-graphite hover:text-ink transition-colors duration-150 cursor-pointer"
            >
              <span data-ct-text>...</span>
            </a>
          </li>
          <li>
            <a
              data-ct={phoneEncoded}
              data-ct-type="phone"
              class="text-graphite hover:text-ink transition-colors duration-150 cursor-pointer"
            >
              <span data-ct-text>...</span>
            </a>
          </li>
          <li class="text-graphite leading-relaxed">
            {config.contact.address}
          </li>
        </ul>
      </div>
    </div>

    <!-- Title block (Schriftfeld) — the drawing's signature field -->
    <div class="mt-14 border border-ink bg-paper">
      <div class="grid grid-cols-2 lg:grid-cols-4">
        <div class="px-4 py-3 border-b lg:border-b-0 border-r border-ink/30">
          <span class="block font-mono text-[0.5625rem] uppercase tracking-[0.12em] text-graphite mb-1">{tb.project}</span>
          <span class="block font-mono text-xs uppercase tracking-[0.06em] text-ink">creative-it e.U.</span>
        </div>
        <div class="px-4 py-3 border-b lg:border-b-0 lg:border-r border-ink/30">
          <span class="block font-mono text-[0.5625rem] uppercase tracking-[0.12em] text-graphite mb-1">{tb.drawn}</span>
          <span class="block font-mono text-xs uppercase tracking-[0.06em] text-ink">G. Wieser</span>
        </div>
        <div class="px-4 py-3 border-r border-ink/30">
          <span class="block font-mono text-[0.5625rem] uppercase tracking-[0.12em] text-graphite mb-1">{tb.loc}</span>
          <span class="block font-mono text-xs uppercase tracking-[0.06em] text-ink">Gösing am Wagram, AT</span>
        </div>
        <div class="px-4 py-3">
          <span class="block font-mono text-[0.5625rem] uppercase tracking-[0.12em] text-graphite mb-1">{tb.sheet}</span>
          <span class="block font-mono text-xs uppercase tracking-[0.06em] text-ink">&copy; {new Date().getFullYear()}</span>
        </div>
      </div>
      <div class="border-t border-ink/30 px-4 py-3 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-graphite">
          <p>&copy; {new Date().getFullYear()} {config.name}. {rightsLabel}</p>
          <a href={localePath('/legal', locale)} class="hover:text-ink transition-colors duration-150 underline-offset-4 hover:underline">{legalLabel}</a>
          <a href={localePath('/privacy', locale)} class="hover:text-ink transition-colors duration-150 underline-offset-4 hover:underline">{privacyLabel}</a>
        </div>
        <p class="font-mono text-[0.6875rem] text-graphite tracking-[0.04em]">
          {colophon}
        </p>
      </div>
    </div>
  </div>
</footer>
