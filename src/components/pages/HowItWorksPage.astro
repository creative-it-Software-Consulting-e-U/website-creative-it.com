---
import Layout from "../../layouts/Layout.astro";
import { t, type Locale } from "../../config/site";
const locale = (Astro.currentLocale || 'en') as Locale;
const config = t(locale);
const p = config.pages.howItWorks;
---

<Layout title={p.meta.title} description={p.meta.description}>
  <!-- Hero -->
  <section class="relative py-20 lg:py-32 overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[400px] h-[250px] md:w-[800px] md:h-[500px] bg-[radial-gradient(ellipse,rgba(161,99,241,0.08)_0%,rgba(99,99,241,0.05)_40%,transparent_70%)]"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="chip mb-4 animate-fade-in-up opacity-0" style="animation-delay: 0.1s; animation-fill-mode: forwards;">
          <span class="w-1.5 h-1.5 rounded-full bg-purple animate-pulse"></span>
          <span>{p.hero.chip}</span>
        </div>
        <h1 class="heading-xl text-5xl lg:text-6xl xl:text-7xl text-off-white mb-6 animate-fade-in-up opacity-0" style="animation-delay: 0.2s; animation-fill-mode: forwards;">
          {p.hero.headline.before}<span class="gradient-text">{p.hero.headline.gradient}</span>{p.hero.headline.after}
        </h1>
        <p class="text-lg lg:text-xl text-text-secondary leading-relaxed animate-fade-in-up opacity-0" style="animation-delay: 0.3s; animation-fill-mode: forwards;">
          {p.hero.description}
        </p>
      </div>
    </div>
  </section>

  <!-- Quick-Nav Grid -->
  <section class="pb-20 relative">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 reveal">
        {p.features.map((feature, index) => (
          <a
            href={`#${feature.id}`}
            class="group card p-5 hover:border-purple/30 transition-all duration-300"
            style={`transition-delay: ${index * 50}ms`}
          >
            <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-purple/20 to-indigo/10 border border-purple/20 flex items-center justify-center mb-3 group-hover:border-purple/40 transition-colors duration-300">
              {feature.icon === "lightning" && (
                <svg class="w-4 h-4 text-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
              )}
              {feature.icon === "beaker" && (
                <svg class="w-4 h-4 text-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>
              )}
              {feature.icon === "robot" && (
                <svg class="w-4 h-4 text-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              )}
              {feature.icon === "chat" && (
                <svg class="w-4 h-4 text-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
              )}
              {feature.icon === "paintbrush" && (
                <svg class="w-4 h-4 text-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42" /></svg>
              )}
              {feature.icon === "globe" && (
                <svg class="w-4 h-4 text-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" /></svg>
              )}
              {feature.icon === "code" && (
                <svg class="w-4 h-4 text-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
              )}
            </div>
            <h3 class="heading-md text-sm text-off-white mb-1 group-hover:text-purple transition-colors duration-300">{feature.title}</h3>
            <p class="text-xs text-text-muted">{feature.subtitle}</p>
          </a>
        ))}
        <!-- Architecture card -->
        <a
          href="#architecture"
          class="group card p-5 hover:border-purple/30 transition-all duration-300"
          style={`transition-delay: ${p.features.length * 50}ms`}
        >
          <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-cyan/20 to-indigo/10 border border-cyan/20 flex items-center justify-center mb-3 group-hover:border-cyan/40 transition-colors duration-300">
            <svg class="w-4 h-4 text-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" /></svg>
          </div>
          <h3 class="heading-md text-sm text-off-white mb-1 group-hover:text-cyan transition-colors duration-300">Architecture</h3>
          <p class="text-xs text-text-muted">Full AWS service map</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Feature Detail Sections -->
  {p.features.map((feature, index) => (
    <section
      id={feature.id}
      class:list={["py-20 lg:py-28 relative overflow-hidden", index % 2 === 1 ? "bg-surface" : ""]}
      style="scroll-margin-top: 6rem"
    >
      {index % 2 === 1 && (
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-purple/3 to-transparent"></div>
      )}

      <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
        <!-- Header -->
        <div class="max-w-3xl mb-12 reveal">
          <div class="chip mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-purple animate-pulse"></span>
            <span>{feature.title}</span>
          </div>
          <h2 class="heading-lg text-3xl lg:text-4xl text-off-white mb-4">{feature.subtitle}</h2>
          <p class="text-text-secondary text-lg leading-relaxed mb-4">{feature.whatItDoes}</p>
          {feature.link && (
            <a
              href={feature.link}
              class="inline-flex items-center gap-1.5 text-sm text-purple hover:text-cyan transition-colors duration-200"
            >
              Try it
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </a>
          )}
        </div>

        <!-- How It Works -->
        <div class="mb-12 reveal" style="transition-delay: 100ms">
          <h3 class="heading-md text-xl text-off-white mb-4">How It Works</h3>
          <p class="text-text-secondary leading-relaxed max-w-3xl">{feature.howItWorks}</p>
        </div>

        <!-- Technical Flow -->
        <div class="mb-12">
          <h3 class="heading-md text-lg text-off-white mb-6 reveal" style="transition-delay: 150ms">Technical Flow</h3>
          <div class="grid md:grid-cols-2 gap-4">
            {feature.techFlow.map((step, stepIndex) => (
              <div class="group card p-5 reveal" style={`transition-delay: ${200 + stepIndex * 50}ms`}>
                <div class="flex items-start gap-4">
                  <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-gradient-to-br from-purple/20 to-indigo/10 border border-purple/20 flex items-center justify-center">
                    <span class="heading-md text-purple text-xs">{String(stepIndex + 1).padStart(2, '0')}</span>
                  </div>
                  <p class="text-text-secondary text-sm leading-relaxed">{step}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- AWS Services -->
        <div>
          <h3 class="heading-md text-lg text-off-white mb-6 reveal" style="transition-delay: 200ms">AWS Services</h3>
          <div class="flex flex-wrap gap-3 reveal" style="transition-delay: 250ms">
            {feature.awsServices.map((service) => (
              <div class="card px-4 py-3">
                <div class="text-sm font-medium text-off-white mb-0.5">{service.name}</div>
                <div class="text-xs text-text-muted">{service.role}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- Architecture Overview -->
  <section id="architecture" class="py-20 lg:py-28 bg-surface relative overflow-hidden" style="scroll-margin-top: 6rem">
    <div class="absolute inset-0 bg-gradient-to-br from-purple/3 via-transparent to-cyan/3"></div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-2xl mb-16 reveal">
        <div class="chip mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-purple animate-pulse"></span>
          <span>{p.architectureSection.chip}</span>
        </div>
        <h2 class="heading-lg text-4xl lg:text-5xl text-off-white mb-6">
          {p.architectureSection.headline.before}<span class="gradient-text">{p.architectureSection.headline.gradient}</span>{p.architectureSection.headline.after}
        </h2>
        <p class="text-text-secondary text-lg leading-relaxed">{p.architectureSection.description}</p>
      </div>

      <div class="space-y-12">
        {p.architectureSection.categories.map((category, catIndex) => (
          <div class="reveal" style={`transition-delay: ${catIndex * 100}ms`}>
            <h3 class="heading-md text-xl text-off-white mb-4 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-purple"></span>
              {category.title}
            </h3>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {category.services.map((service) => (
                <div class="card-elevated p-5">
                  <div class="text-sm font-semibold text-off-white mb-1">{service.name}</div>
                  <p class="text-xs text-text-secondary leading-relaxed">{service.description}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 lg:py-32 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="relative rounded-3xl overflow-hidden reveal">
        <div class="absolute inset-0 bg-gradient-to-br from-purple via-indigo to-indigo"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(35,240,195,0.15),transparent_60%)]"></div>

        <div class="relative px-8 py-16 lg:px-16 lg:py-24 text-center">
          <h2 class="heading-xl text-4xl lg:text-5xl xl:text-6xl text-white mb-6">{p.cta.headline}</h2>
          <p class="text-white/70 text-lg max-w-2xl mx-auto mb-10">{p.cta.description}</p>
          <a href="/contact" class="btn-primary">{p.cta.button}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
