---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../Breadcrumbs.astro";
import CtaBlock from "../CtaBlock.astro";
import { t, type Locale } from "../../config/site";
import { localePath } from "../../utils/i18n";
const locale = (Astro.currentLocale || 'en') as Locale;
const config = t(locale);
const p = config.pages.about;
const why = config.about.whyChooseUs;
---

<Layout title={p.meta.title} description={p.meta.description}>
  <Breadcrumbs items={[{ name: p.meta.title }]} locale={locale} />

  <!-- Hero / Essay opening: text left, portrait right -->
  <section class="relative py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
        <div class="lg:col-span-7">
          <div class="chip mb-6 animate-fade-in-up opacity-0" style="animation-delay: 0.1s; animation-fill-mode: forwards;">
            <span>{p.hero.chip}</span>
          </div>
          <h1 class="heading-xl text-5xl lg:text-6xl text-ink mb-8 animate-fade-in-up opacity-0" style="animation-delay: 0.2s; animation-fill-mode: forwards;">
            Hi!
          </h1>
          <div class="space-y-5 max-w-[68ch] animate-fade-in-up opacity-0" style="animation-delay: 0.3s; animation-fill-mode: forwards;">
            {config.about.essenz.map((paragraph: string) => (
              <p class="text-lg text-graphite leading-relaxed" set:html={paragraph} />
            ))}
          </div>
        </div>

        <figure class="lg:col-span-5 animate-fade-in-up opacity-0" style="animation-delay: 0.4s; animation-fill-mode: forwards;">
          <img
            src="/about-photo.jpg"
            alt="Günther Wieser — Founder of creative-it"
            width="2962"
            height="2952"
            class="w-full h-auto border border-rule"
            loading="eager"
          />
          <figcaption class="font-mono text-xs text-graphite tracking-[0.04em] mt-3">
            Günther Wieser · Gösing am Wagram
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Full Story — reading column -->
  <section id="full-story" class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex items-baseline gap-4 mb-14 lg:mb-20">
        <span class="font-mono text-xs uppercase tracking-[0.08em] text-graphite">01 — {p.storySection.chip}</span>
        <div class="flex-1 h-px bg-rule"></div>
      </div>

      <div class="max-w-[68ch] mx-auto">
        <h2 class="heading-lg text-4xl lg:text-5xl text-ink mb-10">{p.storySection.headline}</h2>
        <div class="space-y-6">
          {config.about.fullStory.map((paragraph: string) => (
            <p class="text-graphite text-lg leading-relaxed" set:html={paragraph} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex items-baseline gap-4 mb-14 lg:mb-20">
        <span class="font-mono text-xs uppercase tracking-[0.08em] text-graphite">02 — {p.valuesSection.chip}</span>
        <div class="flex-1 h-px bg-rule"></div>
      </div>

      <h2 class="heading-lg text-4xl lg:text-5xl text-ink mb-14">
        {p.valuesSection.headline.before}<span class="gradient-text">{p.valuesSection.headline.gradient}</span>{p.valuesSection.headline.after}
      </h2>

      <div class="grid md:grid-cols-3 gap-x-10 gap-y-8">
        {config.about.values.map((value, index) => (
          <div class="border-t border-rule pt-6">
            <div class="font-serif text-5xl text-rule mb-4">{String(index + 1).padStart(2, '0')}</div>
            <h3 class="heading-md text-2xl text-ink mb-3">{value.title}</h3>
            <p class="text-graphite leading-relaxed">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why work with me -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex items-baseline gap-4 mb-14 lg:mb-20">
        <span class="font-mono text-xs uppercase tracking-[0.08em] text-graphite">03 — {p.whySection.chip}</span>
        <div class="flex-1 h-px bg-rule"></div>
      </div>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20">
        <div>
          <h2 class="heading-lg text-4xl lg:text-5xl text-ink mb-8">{why.headline}</h2>
          <p class="text-graphite text-lg leading-relaxed">{why.description}</p>
        </div>

        <div>
          {why.benefits.map((item) => (
            <div class="py-5 border-t border-rule last:border-b">
              <h3 class="heading-md text-lg text-ink mb-1">{item.title}</h3>
              <p class="text-graphite text-sm leading-relaxed">{item.description}</p>
            </div>
          ))}

          <div class="mt-10 grid gap-4">
            {why.highlights.map((item) => (
              <div class="flex items-baseline justify-between gap-6 border-t border-rule pt-4">
                <span class="heading-md text-lg text-ink">{item.title}</span>
                <span class="font-mono text-xs text-graphite text-right">{item.description}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBlock
    headline={p.cta.headline}
    description={p.cta.description}
    button={p.cta.button}
    href={localePath("/contact", locale)}
  />
</Layout>
