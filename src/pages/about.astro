---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../config/site";
---

<Layout title="About" description="Learn more about creative-it and our Build. Grow. Matter. philosophy">
  <!-- Hero -->
  <section class="relative py-20 lg:py-32 overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-gradient-to-br from-mint/5 via-transparent to-light-blue/5"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="subheadline text-mint mb-4 block animate-fade-in-up opacity-0" style="animation-delay: 0.1s; animation-fill-mode: forwards;">About Us</span>
          <h1 class="headline text-5xl lg:text-6xl xl:text-7xl text-off-white mb-6 animate-fade-in-up opacity-0" style="animation-delay: 0.2s; animation-fill-mode: forwards;">
            We Build With <span class="gradient-text">Purpose</span>
          </h1>
          <p class="text-xl text-off-white/60 leading-relaxed animate-fade-in-up opacity-0" style="animation-delay: 0.3s; animation-fill-mode: forwards;">
            {siteConfig.about.mission}
          </p>
        </div>

        <!-- Logo display -->
        <div class="relative animate-fade-in-up opacity-0" style="animation-delay: 0.4s; animation-fill-mode: forwards;">
          <div class="relative aspect-square max-w-md mx-auto">
            <div class="absolute inset-0 bg-gradient-to-br from-mint/10 to-light-blue/10 rounded-3xl"></div>
            <div class="absolute inset-4 bg-dark-grey rounded-2xl flex items-center justify-center p-12">
              <img src="/logo-dark.png" alt={siteConfig.name} class="w-full h-auto" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Story Section -->
  <section class="py-24 lg:py-32 bg-dark-grey relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-mint/5 to-transparent"></div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16 reveal">
          <span class="subheadline text-mint mb-4 block">Our Story</span>
          <h2 class="headline text-4xl lg:text-5xl text-off-white mb-8">
            The Philosophy Behind Everything We Do
          </h2>
        </div>

        <div class="prose prose-lg prose-invert mx-auto reveal">
          <p class="text-off-white/70 text-lg leading-relaxed mb-8">
            {siteConfig.about.story}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="py-24 lg:py-32 relative">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-16 reveal">
        <span class="subheadline text-mint mb-4 block">Our Values</span>
        <h2 class="headline text-4xl lg:text-5xl text-off-white">
          Build. Grow. Matter.
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8 reveal">
        {siteConfig.about.values.map((value, index) => (
          <div
            class="group relative"
            style={`transition-delay: ${index * 150}ms`}
          >
            <!-- Card -->
            <div class="relative h-full bg-midnight-light rounded-2xl p-10 border border-white/5 hover:border-mint/30 transition-all duration-500 overflow-hidden">
              <!-- Background gradient on hover -->
              <div class="absolute inset-0 bg-gradient-to-br from-mint/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

              <div class="relative">
                <!-- Number -->
                <div class="headline text-8xl text-mint/10 absolute -top-4 -left-2 group-hover:text-mint/20 transition-colors duration-500">
                  {String(index + 1).padStart(2, '0')}
                </div>

                <!-- Content -->
                <div class="relative pt-12">
                  <h3 class="headline text-3xl text-off-white mb-4 group-hover:text-mint transition-colors duration-300">
                    {value.title}
                  </h3>
                  <p class="text-off-white/60 leading-relaxed">
                    {value.description}
                  </p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-24 lg:py-32 bg-dark-grey">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12 reveal">
        {siteConfig.about.stats.map((stat, index) => (
          <div
            class="text-center p-8 rounded-2xl bg-midnight border border-white/5"
            style={`transition-delay: ${index * 100}ms`}
          >
            <div class="headline text-4xl lg:text-5xl xl:text-6xl gradient-text mb-2">
              {stat.value}
            </div>
            <div class="text-sm text-off-white/50 uppercase tracking-wider">
              {stat.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-24 lg:py-32 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div class="reveal">
          <span class="subheadline text-mint mb-4 block">Why Choose Us</span>
          <h2 class="headline text-4xl lg:text-5xl text-off-white mb-8">
            Partnership, Not Just Service
          </h2>
          <p class="text-off-white/60 text-lg leading-relaxed mb-8">
            We don't just deliver projects—we build relationships. When you work with creative-it, you gain a technology partner invested in your long-term success. We take the time to understand your business, your challenges, and your vision.
          </p>

          <div class="space-y-6">
            {[
              { title: "Deep Expertise", description: "Years of experience across diverse industries and technologies." },
              { title: "Transparent Communication", description: "Clear, honest dialogue throughout every engagement." },
              { title: "Long-term Vision", description: "Solutions designed to grow with your business." },
            ].map((item) => (
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-lg bg-mint/10 flex items-center justify-center flex-shrink-0 mt-1">
                  <svg class="w-5 h-5 text-mint" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div>
                  <h3 class="headline text-lg text-off-white mb-1">{item.title}</h3>
                  <p class="text-off-white/60 text-sm">{item.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Visual element -->
        <div class="relative reveal" style="transition-delay: 200ms">
          <div class="relative">
            <!-- Decorative shapes -->
            <div class="absolute -inset-4 bg-gradient-to-br from-mint/20 to-light-blue/10 rounded-3xl transform rotate-2"></div>
            <div class="relative bg-dark-grey rounded-2xl p-12 border border-white/5">
              <div class="space-y-8">
                <div class="flex items-center gap-4">
                  <div class="w-16 h-16 rounded-2xl bg-mint flex items-center justify-center">
                    <svg class="w-8 h-8 text-midnight" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                  </div>
                  <div>
                    <div class="headline text-2xl text-off-white">Fast & Efficient</div>
                    <div class="text-off-white/50 text-sm">Agile delivery without compromise</div>
                  </div>
                </div>

                <div class="flex items-center gap-4">
                  <div class="w-16 h-16 rounded-2xl bg-light-blue flex items-center justify-center">
                    <svg class="w-8 h-8 text-midnight" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                  </div>
                  <div>
                    <div class="headline text-2xl text-off-white">Expert Team</div>
                    <div class="text-off-white/50 text-sm">Seasoned professionals at every level</div>
                  </div>
                </div>

                <div class="flex items-center gap-4">
                  <div class="w-16 h-16 rounded-2xl bg-mint-bright flex items-center justify-center">
                    <svg class="w-8 h-8 text-midnight" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                  </div>
                  <div>
                    <div class="headline text-2xl text-off-white">Reliable Support</div>
                    <div class="text-off-white/50 text-sm">We're with you for the long haul</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 lg:py-32 bg-dark-grey">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="relative rounded-3xl overflow-hidden reveal">
        <div class="absolute inset-0 bg-gradient-to-br from-mint via-mint to-mint-bright"></div>

        <div class="relative px-8 py-16 lg:px-16 lg:py-24 text-center">
          <h2 class="headline text-4xl lg:text-5xl text-midnight mb-6">
            Let's Build Together
          </h2>
          <p class="text-midnight/70 text-lg max-w-2xl mx-auto mb-10">
            Ready to partner with a team that's invested in your success? Let's start a conversation.
          </p>
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-8 py-4 bg-midnight text-off-white font-semibold text-sm uppercase tracking-wider rounded-full hover:bg-midnight-light transition-colors duration-300"
          >
            <span>Get in Touch</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
