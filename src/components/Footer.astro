---
import { t, type Locale } from "../config/site";
import { localePath } from "../utils/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale || (Astro.currentLocale as Locale) || 'en';
const config = t(locale);
const emailEncoded = btoa(config.contact.email);
const phoneEncoded = btoa(config.contact.phone);

const navLabel = locale === 'de' ? 'Navigation' : 'Navigation';
const servicesLabel = locale === 'de' ? 'Dienstleistungen' : 'Services';
const contactLabel = locale === 'de' ? 'Kontakt' : 'Contact';
const legalLabel = locale === 'de' ? 'Impressum' : 'Legal Notice';
const privacyLabel = locale === 'de' ? 'Datenschutz' : 'Privacy Policy';
const rightsLabel = locale === 'de' ? 'Alle Rechte vorbehalten.' : 'All rights reserved.';
---

<footer class="relative bg-navy border-t border-ink/5">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16 lg:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8">
      <!-- Brand Column -->
      <div class="lg:col-span-5 flex flex-col items-center text-center">
        <a href={localePath('/', locale)} class="mb-6 flex flex-col items-center gap-4">
          <img
            src="/logo-only.webp"
            alt=""
            width="504"
            height="548"
            loading="lazy"
            decoding="async"
            class="h-14 w-auto"
          />
          <span class="font-serif text-2xl text-ink tracking-tight">creative-it<span class="text-rubric">.</span></span>
        </a>
        <p class="text-text-muted text-sm leading-relaxed max-w-sm mb-8">
          {config.description}
        </p>

        <!-- Social Links -->
        <div class="flex items-center gap-3">
          <a
            href={config.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-lg bg-navy-light border border-ink/5 flex items-center justify-center text-text-muted hover:text-cyan hover:border-cyan/30 transition-all duration-300"
            aria-label="LinkedIn"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
          <a
            href={config.social.twitter}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-lg bg-navy-light border border-ink/5 flex items-center justify-center text-text-muted hover:text-cyan hover:border-cyan/30 transition-all duration-300"
            aria-label="Twitter"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <a
            href={config.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-lg bg-navy-light border border-ink/5 flex items-center justify-center text-text-muted hover:text-cyan hover:border-cyan/30 transition-all duration-300"
            aria-label="GitHub"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Navigation -->
      <div class="lg:col-span-2">
        <h4 class="label text-text-secondary mb-6">{navLabel}</h4>
        <ul class="space-y-3">
          {config.navigation.flatMap((item) =>
            item.children
              ? item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class="text-text-muted hover:text-off-white transition-colors duration-200 text-sm"
                    >
                      {child.name}
                    </a>
                  </li>
                ))
              : (
                  <li>
                    <a
                      href={item.href}
                      class="text-text-muted hover:text-off-white transition-colors duration-200 text-sm"
                    >
                      {item.name}
                    </a>
                  </li>
                )
          )}
        </ul>
      </div>

      <!-- Services -->
      <div class="lg:col-span-2">
        <h4 class="label text-text-secondary mb-6">{servicesLabel}</h4>
        <ul class="space-y-3">
          {config.services.map((service) => (
            <li>
              <a
                href={`${localePath('/services', locale)}#${service.title.toLowerCase().replace(/[\s-]+/g, '-').replace(/[^a-z0-9-]/g, '')}`}
                class="text-text-muted hover:text-off-white transition-colors duration-200 text-sm"
              >
                {service.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div class="lg:col-span-3">
        <h4 class="label text-text-secondary mb-6">{contactLabel}</h4>
        <ul class="space-y-4">
          <li>
            <a
              data-ct={emailEncoded}
              data-ct-type="email"
              class="text-text-muted hover:text-cyan transition-colors duration-200 text-sm flex items-center gap-3 cursor-pointer"
            >
              <svg class="w-4 h-4 text-indigo flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span data-ct-text>...</span>
            </a>
          </li>
          <li>
            <a
              data-ct={phoneEncoded}
              data-ct-type="phone"
              class="text-text-muted hover:text-cyan transition-colors duration-200 text-sm flex items-center gap-3 cursor-pointer"
            >
              <svg class="w-4 h-4 text-indigo flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span data-ct-text>...</span>
            </a>
          </li>
          <li class="text-text-muted text-sm flex items-start gap-3">
            <svg class="w-4 h-4 text-indigo flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            {config.contact.address}
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-16 pt-8 border-t border-ink/5 flex flex-col sm:flex-row justify-between items-center gap-4">
      <div class="flex items-center gap-4">
        <p class="text-text-muted text-sm">
          &copy; {new Date().getFullYear()} {config.name}. {rightsLabel}
        </p>
        <a href={localePath('/legal', locale)} class="text-text-muted hover:text-off-white transition-colors duration-200 text-sm">{legalLabel}</a>
        <a href={localePath('/privacy', locale)} class="text-text-muted hover:text-off-white transition-colors duration-200 text-sm">{privacyLabel}</a>
      </div>
      <p class="text-sm font-medium">
        <span class="gradient-text">{config.tagline}</span>
      </p>
    </div>
  </div>
</footer>
