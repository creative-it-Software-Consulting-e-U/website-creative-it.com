---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getCollection } from "astro:content";
import { render } from "astro:content";
import { siteConfig } from "../../config/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const slug = post.id;
const { Content } = await render(post);

const metaDescription = post.data.metaDescription ?? post.data.brief;
const postUrl = `https://www.creative-it.com/blog/${slug}/`;
const modified = post.data.updatedAt ?? post.data.publishedAt;

const linkedService = post.data.service
  ? siteConfig.services.find((s) => s.slug === post.data.service)
  : null;

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
}

const postSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": postUrl,
  headline: post.data.title,
  description: metaDescription,
  url: postUrl,
  mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
  inLanguage: "en",
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: modified.toISOString(),
  ...(post.data.tags.length > 0 && { keywords: post.data.tags.join(", ") }),
  ...(post.data.coverImage && {
    image: {
      "@type": "ImageObject",
      url: `https://www.creative-it.com${post.data.coverImage}`,
    },
  }),
  author: {
    "@type": "Person",
    "@id": "https://www.creative-it.com/#person",
    name: "Günther Wieser",
    url: "https://www.creative-it.com/about/",
  },
  publisher: {
    "@type": "Organization",
    "@id": "https://www.creative-it.com/#organization",
    name: "creative-it Software Consulting e.U.",
    url: "https://www.creative-it.com/",
    logo: {
      "@type": "ImageObject",
      url: "https://www.creative-it.com/logo-only.webp",
      width: 504,
      height: 548,
    },
  },
};
---

<Layout
  title={post.data.title}
  description={metaDescription}
  ogType="article"
  ogImage={post.data.coverImage || undefined}
  publishedTime={post.data.publishedAt}
  modifiedTime={modified}
  noHreflang
>
  <Breadcrumbs
    items={[
      { name: "Blog", href: "/blog/" },
      { name: post.data.title },
    ]}
    locale="en"
  />
  <script type="application/ld+json" set:html={JSON.stringify(postSchema)} />

  <article class="relative py-20 lg:py-32">
    <div class="absolute inset-0">
      <div class="absolute top-0 left-1/4 w-[300px] h-[200px] md:w-[600px] md:h-[400px]"></div>
    </div>

    <div class="relative max-w-4xl mx-auto px-6 lg:px-8">
      {post.data.coverImage && (
        <div class="mb-10 rounded-2xl overflow-hidden border border-border">
          <img
            src={post.data.coverImage}
            alt={post.data.title}
            width={post.data.coverWidth}
            height={post.data.coverHeight}
            class="w-full h-auto"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )}

      <div class="flex flex-wrap items-center gap-3 text-sm text-text-muted mb-4">
        <time datetime={post.data.publishedAt.toISOString().slice(0, 10)}>
          {formatDate(post.data.publishedAt)}
        </time>
        {post.data.readTimeInMinutes > 0 && (
          <>
            <span class="w-1 h-1 rounded-full bg-text-muted"></span>
            <span>{post.data.readTimeInMinutes} min read</span>
          </>
        )}
        <span class="w-1 h-1 rounded-full bg-text-muted"></span>
        <span>By <a href="/about/" class="text-text-secondary hover:text-cyan transition-colors underline underline-offset-2">Günther Wieser</a></span>
      </div>

      <h1 class="heading-xl text-4xl lg:text-5xl text-off-white mb-6">
        {post.data.title}
      </h1>

      <p class="text-lg text-text-secondary leading-relaxed mb-6">
        {post.data.brief}
      </p>

      {post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-8">
          {post.data.tags.map((tag) => (
            <span class="text-xs px-3 py-1 rounded-full bg-purple/10 text-purple/80 border border-purple/20">
              {tag}
            </span>
          ))}
        </div>
      )}

      <div class="divider mb-10"></div>

      <div class="prose">
        <Content />
      </div>

      <div class="divider mt-10 mb-8"></div>

      {post.data.ctaHeadline && (
        <div class="relative rounded-2xl overflow-hidden mb-10">
          <div class="absolute inset-0 bg-ink"></div>
          <div class="absolute inset-0"></div>
          <div class="relative px-8 py-12 lg:px-12 lg:py-14 text-center">
            <h2 class="heading-lg text-3xl lg:text-4xl text-white mb-4">{post.data.ctaHeadline}</h2>
            <p class="text-white/70 text-lg max-w-xl mx-auto mb-8">
              If you want to put these ideas to work in your business, write to me.
            </p>
            <a href="/contact/" class="btn-primary">Get in Touch</a>
            {linkedService && (
              <div class="mt-6">
                <a
                  href={`/services/${linkedService.slug}/`}
                  class="text-white/60 hover:text-white transition-colors text-sm inline-flex items-center gap-1.5"
                >
                  Learn more about {linkedService.title}
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </a>
              </div>
            )}
          </div>
        </div>
      )}

      <a
        href="/blog/"
        class="inline-flex items-center gap-2 text-cyan hover:text-cyan-bright transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Blog
      </a>
    </div>
  </article>
</Layout>
