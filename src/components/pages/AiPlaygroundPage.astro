---
import Layout from "../../layouts/Layout.astro";
import CtaBlock from "../CtaBlock.astro";
import { t, type Locale } from "../../config/site";
import { localePath } from "../../utils/i18n";
const locale = (Astro.currentLocale || 'en') as Locale;
const config = t(locale);
const p = config.pages.aiPlayground;
---

<Layout title={p.meta.title} description={p.meta.description}>
  <!-- Hero -->
  <section class="relative py-20 lg:py-28 overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[400px] h-[250px] md:w-[800px] md:h-[500px]"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="chip mb-4 animate-fade-in-up opacity-0" style="animation-delay: 0.1s; animation-fill-mode: forwards;">
          <span class="w-1.5 h-1.5 rounded-full bg-purple animate-pulse"></span>
          <span>{p.hero.chip}</span>
        </div>
        <h1 class="heading-xl text-5xl lg:text-6xl xl:text-7xl text-off-white mb-6 animate-fade-in-up opacity-0" style="animation-delay: 0.2s; animation-fill-mode: forwards;">
          {p.hero.headline.before}<span class="gradient-text">{p.hero.headline.gradient}</span>{p.hero.headline.after}
        </h1>
        <p class="text-lg lg:text-xl text-text-secondary leading-relaxed animate-fade-in-up opacity-0" style="animation-delay: 0.3s; animation-fill-mode: forwards;">
          {p.hero.description}
        </p>
      </div>
    </div>
  </section>

  <!-- Playground -->
  <section class="pb-24 lg:pb-32 relative">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-6 reveal">
        <!-- Input Panel -->
        <div class="card-elevated p-6 lg:p-8 flex flex-col">
          <label for="ai-prompt" class="label text-text-muted mb-3">{p.inputSection.promptLabel}</label>
          <textarea
            id="ai-prompt"
            class="w-full h-40 bg-navy/60 border border-ink/[0.08] rounded-xl px-4 py-3 text-off-white placeholder-text-muted resize-none focus:outline-none focus:border-indigo focus:shadow-[0_0_0_3px_rgba(28,27,26,0.12)] transition-all duration-200"
            placeholder={p.inputSection.promptPlaceholder}
            maxlength={p.inputSection.charLimit}
          ></textarea>
          <div class="flex items-center justify-between mt-2 mb-4">
            <span id="char-count" class="text-xs text-text-muted">0 / {p.inputSection.charLimit}</span>
            <span id="remaining-requests" class="text-xs text-text-muted"></span>
          </div>

          <!-- Example Chips -->
          <div class="mb-6">
            <p class="text-xs text-text-muted mb-3">{locale === 'de' ? 'Beschreiben Sie oben frei, was Sie brauchen — oder lassen Sie sich inspirieren:' : 'Describe anything you need above — or get inspired:'}</p>
            <div class="flex flex-wrap gap-2">
              {p.examples.map((example) => (
                <button
                  class="example-chip text-xs bg-purple/10 border border-purple/20 text-purple rounded-full px-3 py-1.5 hover:bg-purple/20 hover:border-purple/30 transition-colors duration-200 cursor-pointer text-left"
                  data-prompt={example}
                >
                  {example.length > 55 ? example.slice(0, 55) + "..." : example}
                </button>
              ))}
            </div>
          </div>

          <!-- Conversation indicator + New Component button -->
          <div id="conversation-bar" class="hidden flex items-center justify-between mb-3">
            <div class="chip text-xs">
              <span class="w-1.5 h-1.5 rounded-full bg-cyan animate-pulse"></span>
              <span id="refining-label">{p.conversation.refiningLabel} &middot; 2 messages</span>
            </div>
            <button id="new-component-btn" class="text-xs text-text-muted hover:text-off-white border border-ink/[0.08] rounded-lg px-3 py-1.5 transition-colors duration-200 cursor-pointer">
              {p.conversation.newComponentButton}
            </button>
          </div>

          <button
            id="generate-btn"
            class="btn-glow w-full mt-auto"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            <span id="generate-btn-text">{p.inputSection.generateButton}</span>
          </button>
          <p class="text-xs text-text-muted mt-3 text-center">Press <kbd class="px-1.5 py-0.5 bg-navy/60 border border-ink/[0.08] rounded text-[10px]">Ctrl</kbd> + <kbd class="px-1.5 py-0.5 bg-navy/60 border border-ink/[0.08] rounded text-[10px]">Enter</kbd> to generate</p>
        </div>

        <!-- Preview Panel -->
        <div class="card-elevated p-6 lg:p-8 flex flex-col min-h-[500px]">
          <!-- Tabs -->
          <div class="flex items-center gap-1 mb-4">
            <button id="tab-preview" class="tab-btn text-sm font-medium px-4 py-2 rounded-lg bg-purple/10 text-purple border border-purple/20 transition-colors duration-200 cursor-pointer">
              {p.previewSection.previewTab}
            </button>
            <button id="tab-code" class="tab-btn text-sm font-medium px-4 py-2 rounded-lg text-text-muted hover:text-off-white transition-colors duration-200 cursor-pointer">
              {p.previewSection.codeTab}
            </button>
            <div class="flex-1"></div>
            <button id="copy-btn" class="hidden text-xs text-text-muted hover:text-cyan border border-ink/[0.08] rounded-lg px-3 py-1.5 transition-colors duration-200 cursor-pointer">
              {p.previewSection.copyButton}
            </button>
            <button id="clear-btn" class="hidden text-xs text-text-muted hover:text-off-white border border-ink/[0.08] rounded-lg px-3 py-1.5 transition-colors duration-200 cursor-pointer">
              {p.previewSection.clearButton}
            </button>
          </div>

          <!-- Viewport toggles -->
          <div id="viewport-bar" class="hidden flex items-center justify-center gap-1 mb-3">
            <button data-viewport="desktop" class="viewport-btn active text-xs font-medium px-3 py-1.5 rounded-lg bg-purple/10 text-purple border border-purple/20 transition-colors duration-200 cursor-pointer flex items-center gap-1.5" title={p.previewSection.desktopLabel}>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" stroke-width="1.5"/><path d="M8 21h8M12 17v4" stroke-width="1.5" stroke-linecap="round"/></svg>
              <span class="hidden sm:inline">{p.previewSection.desktopLabel}</span>
            </button>
            <button data-viewport="tablet" class="viewport-btn text-xs font-medium px-3 py-1.5 rounded-lg text-text-muted hover:text-off-white transition-colors duration-200 cursor-pointer flex items-center gap-1.5" title={p.previewSection.tabletLabel}>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2" stroke-width="1.5"/><path d="M12 18h.01" stroke-width="2" stroke-linecap="round"/></svg>
              <span class="hidden sm:inline">{p.previewSection.tabletLabel}</span>
            </button>
            <button data-viewport="mobile" class="viewport-btn text-xs font-medium px-3 py-1.5 rounded-lg text-text-muted hover:text-off-white transition-colors duration-200 cursor-pointer flex items-center gap-1.5" title={p.previewSection.mobileLabel}>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2" stroke-width="1.5"/><path d="M12 18h.01" stroke-width="2" stroke-linecap="round"/></svg>
              <span class="hidden sm:inline">{p.previewSection.mobileLabel}</span>
            </button>
          </div>

          <!-- Preview iframe -->
          <div id="preview-container" class="flex-1 relative rounded-xl overflow-hidden border border-ink/[0.06] bg-white">
            <div id="empty-state" class="absolute inset-0 flex items-center justify-center bg-navy/95">
              <div class="text-center">
                <svg class="w-12 h-12 text-text-muted/30 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>
                <p class="text-sm text-text-muted">{p.previewSection.emptyState}</p>
              </div>
            </div>
            <div id="viewport-wrapper" class="w-full h-full flex justify-center transition-all duration-300">
              <iframe
                id="preview-iframe"
                class="h-full border-0 transition-[width] duration-300"
                style="width:100%"
                sandbox="allow-scripts"
                title="Component preview"
              ></iframe>
            </div>
          </div>

          <!-- Code view -->
          <div id="code-container" class="hidden flex-1 relative rounded-xl overflow-hidden border border-ink/[0.06]">
            <pre id="code-display" class="w-full h-full bg-navy/95 text-text-secondary text-sm p-4 overflow-auto font-mono whitespace-pre-wrap"></pre>
          </div>

          <!-- Loading indicator -->
          <div id="loading-indicator" class="hidden absolute inset-0 flex items-center justify-center pointer-events-none">
            <div class="flex items-center gap-3 bg-surface/90 backdrop-blur-sm border border-ink/[0.08] rounded-xl px-5 py-3">
              <div class="w-4 h-4 border-2 border-purple border-t-transparent rounded-full animate-spin"></div>
              <span class="text-sm text-text-secondary">Generating...</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Powered by AWS Bedrock badge -->
      <div class="flex justify-center items-center gap-3 mt-6 reveal">
        <div class="chip text-xs">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2L3 7v10l9 5 9-5V7l-9-5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M12 22V12M3 7l9 5 9-5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          </svg>
          Powered by AWS Bedrock
        </div>
        <a href={localePath("/how-it-works#ai-playground", locale)} class="text-xs text-text-muted hover:text-purple transition-colors duration-200">How it works &rarr;</a>
      </div>
    </div>
  </section>

  <CtaBlock
    headline={p.cta.headline}
    description={p.cta.description}
    button={p.cta.button}
    href={localePath("/contact", locale)}
  />
</Layout>

<script>
  const API_URL = import.meta.env.PUBLIC_AI_PLAYGROUND_URL;
  const CHAR_LIMIT = 2000;
  const DEFAULT_PLACEHOLDER = 'A pricing card with three tiers: Starter, Pro, and Enterprise...';
  const REFINING_PLACEHOLDER = 'Describe what to change or refine...';

  const promptEl = document.getElementById('ai-prompt') as HTMLTextAreaElement;
  const charCountEl = document.getElementById('char-count')!;
  const remainingEl = document.getElementById('remaining-requests')!;
  const generateBtn = document.getElementById('generate-btn') as HTMLButtonElement;
  const generateBtnText = document.getElementById('generate-btn-text')!;
  const tabPreview = document.getElementById('tab-preview')!;
  const tabCode = document.getElementById('tab-code')!;
  const previewContainer = document.getElementById('preview-container')!;
  const codeContainer = document.getElementById('code-container')!;
  const codeDisplay = document.getElementById('code-display')!;
  const copyBtn = document.getElementById('copy-btn')!;
  const clearBtn = document.getElementById('clear-btn')!;
  const emptyState = document.getElementById('empty-state')!;
  const iframe = document.getElementById('preview-iframe') as HTMLIFrameElement;
  const loadingIndicator = document.getElementById('loading-indicator')!;
  const exampleChips = document.querySelectorAll('.example-chip');
  const viewportBar = document.getElementById('viewport-bar')!;
  const viewportBtns = document.querySelectorAll('.viewport-btn');
  const conversationBar = document.getElementById('conversation-bar')!;
  const refiningLabel = document.getElementById('refining-label')!;
  const newComponentBtn = document.getElementById('new-component-btn')!;

  let generatedHtml = '';
  let isGenerating = false;
  let activeTab: 'preview' | 'code' = 'preview';
  let conversationHistory: Array<{role: string, content: string}> = [];

  // Character counter
  promptEl.addEventListener('input', () => {
    charCountEl.textContent = `${promptEl.value.length} / ${CHAR_LIMIT}`;
  });

  // Example chips
  exampleChips.forEach(chip => {
    chip.addEventListener('click', () => {
      promptEl.value = (chip as HTMLElement).dataset.prompt ?? '';
      charCountEl.textContent = `${promptEl.value.length} / ${CHAR_LIMIT}`;
      promptEl.focus();
    });
  });

  // Tab switching
  function setActiveTab(tab: 'preview' | 'code') {
    activeTab = tab;
    if (tab === 'preview') {
      tabPreview.classList.add('bg-purple/10', 'text-purple', 'border', 'border-purple/20');
      tabPreview.classList.remove('text-text-muted');
      tabCode.classList.remove('bg-purple/10', 'text-purple', 'border', 'border-purple/20');
      tabCode.classList.add('text-text-muted');
      previewContainer.classList.remove('hidden');
      codeContainer.classList.add('hidden');
    } else {
      tabCode.classList.add('bg-purple/10', 'text-purple', 'border', 'border-purple/20');
      tabCode.classList.remove('text-text-muted');
      tabPreview.classList.remove('bg-purple/10', 'text-purple', 'border', 'border-purple/20');
      tabPreview.classList.add('text-text-muted');
      codeContainer.classList.remove('hidden');
      previewContainer.classList.add('hidden');
    }
  }

  tabPreview.addEventListener('click', () => setActiveTab('preview'));
  tabCode.addEventListener('click', () => setActiveTab('code'));

  // Viewport toggle
  const viewportWidths: Record<string, string> = { desktop: '100%', tablet: '768px', mobile: '375px' };

  viewportBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const vp = (btn as HTMLElement).dataset.viewport!;
      iframe.style.width = viewportWidths[vp];
      viewportBtns.forEach(b => {
        if (b === btn) {
          b.classList.add('bg-purple/10', 'text-purple', 'border', 'border-purple/20');
          b.classList.remove('text-text-muted');
        } else {
          b.classList.remove('bg-purple/10', 'text-purple', 'border', 'border-purple/20');
          b.classList.add('text-text-muted');
        }
      });
    });
  });

  // Syntax highlighting for HTML
  function highlightHtml(code: string): string {
    // Escape HTML entities first
    let escaped = code
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');

    // HTML comments
    escaped = escaped.replace(/&lt;!--[\s\S]*?--&gt;/g, '<span class="hl-comment">$&</span>');

    // Tags: match <tagname ... > and </tagname>
    escaped = escaped.replace(
      /(&lt;\/?)([\w-]+)((?:\s+[\s\S]*?)?)(\/?\s*&gt;)/g,
      (_match, open, tag, attrs, close) => {
        // Highlight attribute names and string values within attrs
        const highlightedAttrs = attrs.replace(
          /([\w-]+)(=)(&quot;[^&]*&quot;)/g,
          '<span class="hl-attr">$1</span>$2<span class="hl-string">$3</span>'
        );
        return `<span class="hl-bracket">${open}</span><span class="hl-tag">${tag}</span>${highlightedAttrs}<span class="hl-bracket">${close}</span>`;
      }
    );

    return escaped;
  }

  // Sanitize HTML — strip <script>, on* handlers, javascript: URLs
  function sanitizeHtml(html: string): string {
    return html
      .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
      .replace(/\bon\w+\s*=\s*(?:"[^"]*"|'[^']*'|[^\s>]+)/gi, '')
      .replace(/href\s*=\s*["']javascript:[^"']*["']/gi, 'href="#"')
      .replace(/src\s*=\s*["']javascript:[^"']*["']/gi, 'src=""');
  }

  // Render HTML into sandboxed iframe
  function renderToIframe(html: string) {
    const sanitized = sanitizeHtml(html);
    const doc = `<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="https://cdn.tailwindcss.com"><\/script>
<style>
  body { margin: 0; padding: 16px; font-family: Inter, system-ui, sans-serif; }
</style>
</head>
<body>${sanitized}</body>
</html>`;

    iframe.srcdoc = doc;

    // Auto-resize iframe after content loads
    iframe.onload = () => {
      try {
        const body = iframe.contentDocument?.body;
        if (body) {
          const height = Math.max(body.scrollHeight + 32, 400);
          iframe.style.height = `${height}px`;
        }
      } catch {
        // Cross-origin — ignore
      }
    };
  }

  // Show/hide action buttons
  function setActionButtonsVisible(visible: boolean) {
    if (visible) {
      copyBtn.classList.remove('hidden');
      clearBtn.classList.remove('hidden');
    } else {
      copyBtn.classList.add('hidden');
      clearBtn.classList.add('hidden');
    }
  }

  // Update conversation UI
  function updateConversationUI() {
    if (conversationHistory.length > 0) {
      conversationBar.classList.remove('hidden');
      const msgCount = conversationHistory.length;
      refiningLabel.innerHTML = `Refining &middot; ${msgCount} message${msgCount !== 1 ? 's' : ''}`;
      promptEl.placeholder = REFINING_PLACEHOLDER;
    } else {
      conversationBar.classList.add('hidden');
      promptEl.placeholder = DEFAULT_PLACEHOLDER;
    }
  }

  // Reset conversation
  function resetConversation() {
    conversationHistory = [];
    updateConversationUI();
  }

  // New Component button
  newComponentBtn.addEventListener('click', () => {
    resetConversation();
    generatedHtml = '';
    codeDisplay.innerHTML = '';
    iframe.srcdoc = '';
    iframe.style.height = '';
    emptyState.classList.remove('hidden');
    setActionButtonsVisible(false);
    viewportBar.classList.add('hidden');
    promptEl.value = '';
    charCountEl.textContent = `0 / ${CHAR_LIMIT}`;
    promptEl.focus();
  });

  // Copy to clipboard
  copyBtn.addEventListener('click', async () => {
    if (!generatedHtml) return;
    try {
      await navigator.clipboard.writeText(generatedHtml);
      copyBtn.textContent = 'Copied!';
      setTimeout(() => { copyBtn.textContent = 'Copy Code'; }, 2000);
    } catch {
      // Fallback
      const textarea = document.createElement('textarea');
      textarea.value = generatedHtml;
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);
      copyBtn.textContent = 'Copied!';
      setTimeout(() => { copyBtn.textContent = 'Copy Code'; }, 2000);
    }
  });

  // Clear
  clearBtn.addEventListener('click', () => {
    generatedHtml = '';
    codeDisplay.innerHTML = '';
    iframe.srcdoc = '';
    iframe.style.height = '';
    emptyState.classList.remove('hidden');
    setActionButtonsVisible(false);
    viewportBar.classList.add('hidden');
    resetConversation();
  });

  // Ctrl/Cmd + Enter shortcut
  promptEl.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      e.preventDefault();
      if (!isGenerating) generate();
    }
  });

  // Generate
  async function generate() {
    const prompt = promptEl.value.trim();
    if (!prompt || isGenerating || !API_URL) return;

    // Build user message for conversation
    const isFirstMessage = conversationHistory.length === 0;
    const userContent = isFirstMessage
      ? `Generate a UI component: ${prompt}`
      : prompt;

    // Add user message to history
    conversationHistory.push({ role: 'user', content: userContent });

    isGenerating = true;
    generatedHtml = '';
    generateBtn.disabled = true;
    generateBtnText.textContent = 'Generating...';
    generateBtn.classList.add('opacity-70');
    loadingIndicator.classList.remove('hidden');
    emptyState.classList.add('hidden');
    setActionButtonsVisible(false);
    codeDisplay.innerHTML = '';

    try {
      const body = JSON.stringify({
          prompt,
          messages: conversationHistory,
        });
      const res = await fetch(API_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body,
      });

      // Update remaining requests
      const remaining = res.headers.get('X-Remaining-Requests');
      if (remaining !== null) {
        remainingEl.textContent = `${remaining} / 10 requests remaining today`;
      }

      if (!res.ok) {
        const err = await res.text();
        let message = 'Failed to generate. Please try again.';
        try {
          const parsed = JSON.parse(err);
          message = parsed.error || message;
        } catch {}
        // Remove the failed user message from history
        conversationHistory.pop();
        throw new Error(message);
      }

      loadingIndicator.classList.add('hidden');
      viewportBar.classList.remove('hidden');

      const reader = res.body?.getReader();
      if (!reader) throw new Error('Streaming not supported');

      const decoder = new TextDecoder();

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        const chunk = decoder.decode(value, { stream: true });
        generatedHtml += chunk;

        // Update live preview
        renderToIframe(generatedHtml);

        // Update code view with syntax highlighting
        codeDisplay.innerHTML = highlightHtml(generatedHtml);
      }

      // Push assistant response to conversation history
      conversationHistory.push({ role: 'assistant', content: generatedHtml });
      updateConversationUI();

      setActionButtonsVisible(true);
      promptEl.value = '';
      charCountEl.textContent = `0 / ${CHAR_LIMIT}`;
    } catch (err) {
      loadingIndicator.classList.add('hidden');
      emptyState.classList.remove('hidden');
      const errorDiv = document.createElement('div');
      errorDiv.className = 'absolute inset-0 flex items-center justify-center bg-navy/95';
      errorDiv.innerHTML = `<div class="text-center px-6"><svg class="w-10 h-10 text-red-400/60 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" /></svg><p class="text-sm text-red-400">${err instanceof Error ? err.message : 'An error occurred'}</p></div>`;
      emptyState.replaceWith(errorDiv);
      // Reset empty state reference for next attempt
      setTimeout(() => {
        errorDiv.outerHTML = `<div id="empty-state" class="absolute inset-0 flex items-center justify-center bg-navy/95"><div class="text-center"><svg class="w-12 h-12 text-text-muted/30 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg><p class="text-sm text-text-muted">Your generated component will appear here</p></div></div>`;
      }, 5000);
      updateConversationUI();
    } finally {
      isGenerating = false;
      generateBtn.disabled = false;
      generateBtnText.textContent = 'Generate';
      generateBtn.classList.remove('opacity-70');
      loadingIndicator.classList.add('hidden');
    }
  }

  generateBtn.addEventListener('click', generate);
</script>
