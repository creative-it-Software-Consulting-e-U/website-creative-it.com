---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { siteConfig } from "../config/site";

const p = siteConfig.pages.blog;

// ── Fetch articles from Hashnode at build time ─────────────────────────────

interface HashnodePost {
  title: string;
  slug: string;
  brief: string;
  tags: { name: string }[];
  publishedAt: string;
  url: string;
  coverImage: { url: string } | null;
  readTimeInMinutes: number;
}

interface HashnodeResponse {
  data: {
    publication: {
      posts: {
        edges: { node: HashnodePost }[];
        pageInfo: { hasNextPage: boolean; endCursor: string | null };
      };
    };
  };
}

const HASHNODE_HOST = "buildgrowmatter.hashnode.dev";
const HASHNODE_GQL = "https://gql.hashnode.com";
const LIVE_SITE = "https://creative-it.com";

const postFields = `
  title
  slug
  brief
  tags { name }
  publishedAt
  url
  coverImage { url }
  readTimeInMinutes
`;

const listingQuery = `
  query Posts($host: String!, $first: Int!, $after: String) {
    publication(host: $host) {
      posts(first: $first, after: $after) {
        edges { node { ${postFields} } }
        pageInfo { hasNextPage endCursor }
      }
    }
  }
`;

const singlePostQuery = `
  query Post($host: String!, $slug: String!) {
    publication(host: $host) {
      post(slug: $slug) { ${postFields} }
    }
  }
`;

// Fetch all posts from the listing endpoint (can be incomplete due to Hashnode bugs)
async function fetchPostsFromListing(): Promise<HashnodePost[]> {
  const result: HashnodePost[] = [];
  let after: string | null = null;

  do {
    const res = await fetch(HASHNODE_GQL, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        query: listingQuery,
        variables: { host: HASHNODE_HOST, first: 20, after },
      }),
    });

    if (!res.ok) break;

    const json = (await res.json()) as HashnodeResponse;
    const { edges, pageInfo } = json.data.publication.posts;
    for (const edge of edges) result.push(edge.node);
    after = pageInfo.hasNextPage ? pageInfo.endCursor : null;
  } while (after);

  return result;
}

// Fetch a single post by slug (reliable even when listing is broken)
async function fetchPostBySlug(slug: string): Promise<HashnodePost | null> {
  try {
    const res = await fetch(HASHNODE_GQL, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        query: singlePostQuery,
        variables: { host: HASHNODE_HOST, slug },
      }),
    });
    if (!res.ok) return null;
    const json = await res.json();
    return json.data?.publication?.post ?? null;
  } catch {
    return null;
  }
}

// Cache format: { slug: coverImageUrl | null }
interface BlogCache {
  [slug: string]: string | null;
}

// Load cached data from both the live site and local file, merge them
async function loadBlogCache(): Promise<BlogCache> {
  const cache: BlogCache = {};

  async function mergeSource(data: unknown) {
    if (data && typeof data === "object" && !Array.isArray(data)) {
      // New format: { slug: coverUrl }
      Object.assign(cache, data);
    } else if (Array.isArray(data)) {
      // Legacy format: ["slug1", "slug2"] — migrate
      for (const s of data) if (typeof s === "string") cache[s] = null;
    }
  }

  // 1. Try live site (from previous deployment)
  try {
    const res = await fetch(`${LIVE_SITE}/blog-slugs.json`);
    if (res.ok) await mergeSource(await res.json());
  } catch {}

  // 2. Try local file (seeded in repo or from previous local build)
  try {
    const { readFileSync } = await import("node:fs");
    const { join } = await import("node:path");
    await mergeSource(JSON.parse(readFileSync(join(process.cwd(), "public", "blog-slugs.json"), "utf-8")));
  } catch {}

  return cache;
}

// ── Fetch with fallback for missing articles & cover images ─────────────────
let posts: HashnodePost[] = [];

try {
  const [listingPosts, cache] = await Promise.all([
    fetchPostsFromListing(),
    loadBlogCache(),
  ]);

  const listingSlugs = new Set(listingPosts.map((p) => p.slug));
  const knownSlugs = Object.keys(cache);
  const missingSlugs = knownSlugs.filter((s) => !listingSlugs.has(s));

  console.log(`[blog] Listing returned ${listingPosts.length} articles, cache has ${knownSlugs.length} known slugs`);

  // Recover articles missing from listing
  if (missingSlugs.length > 0) {
    console.log(`[blog] ${missingSlugs.length} known articles missing from listing, fetching individually: ${missingSlugs.join(", ")}`);
    const recovered = await Promise.all(missingSlugs.map(fetchPostBySlug));
    const recoveredPosts = recovered.filter((p): p is HashnodePost => p !== null);
    if (recoveredPosts.length > 0) {
      console.log(`[blog] Recovered ${recoveredPosts.length} articles via individual slug queries`);
    }
    posts = [...listingPosts, ...recoveredPosts];
  } else {
    posts = listingPosts;
  }

  // Restore missing cover images from cache (Hashnode sometimes returns null)
  for (const post of posts) {
    if (!post.coverImage?.url && cache[post.slug]) {
      console.log(`[blog] Restored cached cover image for: ${post.slug}`);
      post.coverImage = { url: cache[post.slug]! };
    }
  }

  console.log(`[blog] Total: ${posts.length} articles for build`);
} catch (e) {
  console.error("Failed to fetch Hashnode posts:", e);
}

// Save cache: slug → coverImage URL (for recovery in future builds)
if (posts.length > 0) {
  const { writeFileSync } = await import("node:fs");
  const { join } = await import("node:path");
  const slugsPath = join(process.cwd(), "public", "blog-slugs.json");
  const newCache: Record<string, string | null> = {};
  for (const post of posts) {
    newCache[post.slug] = post.coverImage?.url ?? null;
  }
  writeFileSync(slugsPath, JSON.stringify(newCache, null, 2));
  console.log(`[blog] Saved cache with ${posts.length} articles to public/blog-slugs.json`);
}

posts.sort(
  (a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime()
);

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

// JSON-LD Blog schema
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: `${siteConfig.name} Blog`,
  description: p.meta.description,
  url: "https://creative-it.com/blog",
  publisher: {
    "@type": "Organization",
    name: siteConfig.name,
    url: "https://creative-it.com",
  },
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.title,
    description: post.brief,
    url: post.url,
    datePublished: post.publishedAt,
    ...(post.coverImage?.url && { image: post.coverImage.url }),
    author: {
      "@type": "Organization",
      name: siteConfig.name,
    },
  })),
};
---

<Layout title={p.meta.title} description={p.meta.description}>
  <Breadcrumbs items={[{ name: "Blog" }]} />
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />

  <!-- Hero -->
  <section class="relative py-20 lg:py-32 overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute top-0 left-1/4 w-[300px] h-[200px] md:w-[600px] md:h-[400px] bg-[radial-gradient(circle,rgba(161,99,241,0.05)_0%,transparent_70%)]"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <div class="chip mb-4 inline-flex animate-fade-in-up opacity-0" style="animation-delay: 0.1s; animation-fill-mode: forwards;">
        <span>{p.hero.chip}</span>
      </div>
      <h1 class="heading-xl text-5xl lg:text-6xl xl:text-7xl text-off-white mb-6 animate-fade-in-up opacity-0" style="animation-delay: 0.2s; animation-fill-mode: forwards;">
        {p.hero.headline.before}<span class="gradient-text">{p.hero.headline.gradient}</span>{p.hero.headline.after}
      </h1>
      <p class="text-lg text-text-secondary leading-relaxed max-w-2xl mx-auto animate-fade-in-up opacity-0" style="animation-delay: 0.3s; animation-fill-mode: forwards;">
        {p.hero.description}
      </p>
    </div>
  </section>

  <!-- Articles Grid -->
  <section class="py-24 lg:py-32 bg-surface relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-purple/3 to-transparent"></div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      {posts.length === 0 ? (
        <p class="text-center text-text-muted text-lg">No articles found. Check back soon!</p>
      ) : (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post, index) => (
            <a
              href={post.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group reveal"
              style={`transition-delay: ${(index % 6) * 100}ms`}
            >
              <article class="card-elevated h-full flex flex-col overflow-hidden transition-transform duration-300 group-hover:-translate-y-1">
                {post.coverImage?.url ? (
                  <div class="aspect-[16/9] overflow-hidden">
                    <img
                      src={post.coverImage.url}
                      alt={post.title}
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  </div>
                ) : (
                  <div class="aspect-[16/9] bg-gradient-to-br from-purple/20 to-indigo/10 flex items-center justify-center">
                    <svg class="w-12 h-12 text-purple/40" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                    </svg>
                  </div>
                )}

                <div class="p-6 flex flex-col flex-1">
                  <div class="flex items-center gap-3 text-xs text-text-muted mb-3">
                    <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
                    {post.readTimeInMinutes > 0 && (
                      <>
                        <span class="w-1 h-1 rounded-full bg-text-muted"></span>
                        <span>{post.readTimeInMinutes} min read</span>
                      </>
                    )}
                  </div>

                  <h2 class="heading-md text-xl text-off-white mb-3 group-hover:text-purple transition-colors duration-300 line-clamp-2">
                    {post.title}
                  </h2>

                  <p class="text-text-secondary text-sm leading-relaxed mb-4 flex-1 line-clamp-3">
                    {post.brief}
                  </p>

                  {post.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2 mt-auto">
                      {post.tags.slice(0, 3).map((tag) => (
                        <span class="text-xs px-2 py-1 rounded-full bg-purple/10 text-purple/80 border border-purple/20">
                          {tag.name}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 lg:py-32">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="relative rounded-3xl overflow-hidden reveal">
        <div class="absolute inset-0 bg-gradient-to-br from-purple via-indigo to-indigo"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_30%,rgba(35,240,195,0.15),transparent_60%)]"></div>

        <div class="relative px-8 py-16 lg:px-16 lg:py-24 text-center">
          <h2 class="heading-xl text-4xl lg:text-5xl text-white mb-6">{p.cta.headline}</h2>
          <p class="text-white/70 text-lg max-w-2xl mx-auto mb-10">{p.cta.description}</p>
          <a href="/contact" class="btn-primary">{p.cta.button}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
