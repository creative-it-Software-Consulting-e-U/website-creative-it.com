---
import "../styles/global.css";
import { siteConfig } from "../config/site";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  hideStatsBanner?: boolean;
}

const { title, description, hideStatsBanner = false } = Astro.props;
const pageTitle = title ? `${title} | ${siteConfig.name}` : `${siteConfig.name} — ${siteConfig.tagline}`;
const pageDescription = description || siteConfig.description;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />

    <!-- Preconnect to Google Fonts for faster font loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Font: swap display, reduced weights (removed unused 300) -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    </noscript>

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />

    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-navy text-off-white overflow-x-hidden">
    <!-- Ambient background glows -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden">
      <div class="absolute top-0 left-1/4 w-[300px] h-[300px] md:w-[600px] md:h-[600px] bg-[radial-gradient(circle,rgba(161,99,241,0.04)_0%,transparent_70%)]"></div>
      <div class="absolute top-1/3 right-0 w-[250px] h-[250px] md:w-[500px] md:h-[500px] bg-[radial-gradient(circle,rgba(99,99,241,0.05)_0%,transparent_70%)]"></div>
      <div class="absolute bottom-0 left-0 w-[200px] h-[200px] md:w-[400px] md:h-[400px] bg-[radial-gradient(circle,rgba(35,240,195,0.03)_0%,transparent_70%)]"></div>
    </div>

    <Navigation />
    <main class="flex-1 relative z-10">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/contact-protect';
    </script>
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        document.body.classList.add('loaded');

        const observerOptions = {
          root: null,
          rootMargin: '0px',
          threshold: 0.1
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              observer.unobserve(entry.target);
            }
          });
        }, observerOptions);

        document.querySelectorAll('.reveal').forEach(el => {
          observer.observe(el);
        });
      });
    </script>

    <style>
      .reveal {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .reveal.in-view {
        opacity: 1;
        transform: translateY(0);
      }
    </style>

    {!hideStatsBanner && (
      <!-- Collapsible GitHub Stats Banner -->
      <div id="github-stats-wrapper" class="hidden fixed bottom-6 right-0 z-50 flex items-end">
        <!-- Expanded card -->
        <div id="github-stats-banner" class="mr-6 transition-all duration-400 ease-in-out origin-right">
          <div class="relative">
            <!-- Close / collapse button -->
            <button
              id="github-stats-close"
              class="absolute -top-3 -right-3 w-10 h-10 bg-surface border border-white/[0.08] rounded-full flex items-center justify-center text-text-muted hover:text-off-white hover:border-purple/30 transition-colors duration-200 cursor-pointer z-10"
              aria-label="Collapse stats card"
              title="Einklappen"
            >
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
            <a href="/agentic-coding" class="group block bg-surface border border-white/[0.06] rounded-2xl px-5 py-4 shadow-[0_8px_32px_rgba(0,0,0,0.4)] backdrop-blur-sm max-w-xs hover:border-purple/30 transition-colors duration-300">
              <div class="flex items-center gap-2.5 mb-3">
                <svg class="w-5 h-5 text-purple flex-shrink-0" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
                </svg>
                <span class="text-xs text-text-muted leading-tight">Code changes made by our team of agentic coding agents</span>
              </div>
              <div class="space-y-1.5 text-sm">
                <div class="flex items-center justify-between">
                  <span class="text-text-muted">Last 24h</span>
                  <span id="stats-24h" class="text-text-secondary font-medium"></span>
                </div>
                <div class="w-full h-px bg-white/[0.04]"></div>
                <div class="flex items-center justify-between">
                  <span class="text-text-muted">Last 7d</span>
                  <span id="stats-7d" class="text-text-secondary font-medium"></span>
                </div>
              </div>
              <div class="mt-3 pt-3 border-t border-white/[0.04] flex items-center justify-center gap-1.5 text-xs text-indigo group-hover:text-purple transition-colors duration-300">
                <span>Learn about agentic coding</span>
                <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
              </div>
            </a>
          </div>
        </div>

        <!-- Collapsed toggle button (AI icon) -->
        <button
          id="github-stats-toggle"
          class="hidden flex items-center justify-center w-12 h-12 bg-surface border border-white/[0.06] border-r-0 rounded-l-xl shadow-[0_8px_32px_rgba(0,0,0,0.4)] backdrop-blur-sm hover:border-purple/30 transition-all duration-300 cursor-pointer group"
          aria-label="Show agentic coding stats"
          title="Agentic Coding Stats"
        >
          <!-- Stylized AI / neural network icon -->
          <svg class="w-6 h-6 text-purple group-hover:text-cyan transition-colors duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <!-- Central brain node -->
            <circle cx="12" cy="12" r="2.5" fill="currentColor" stroke="none" />
            <!-- Outer orbit nodes -->
            <circle cx="12" cy="4" r="1.5" fill="currentColor" stroke="none" opacity="0.7" />
            <circle cx="19" cy="8" r="1.5" fill="currentColor" stroke="none" opacity="0.7" />
            <circle cx="19" cy="16" r="1.5" fill="currentColor" stroke="none" opacity="0.7" />
            <circle cx="12" cy="20" r="1.5" fill="currentColor" stroke="none" opacity="0.7" />
            <circle cx="5" cy="16" r="1.5" fill="currentColor" stroke="none" opacity="0.7" />
            <circle cx="5" cy="8" r="1.5" fill="currentColor" stroke="none" opacity="0.7" />
            <!-- Connection lines -->
            <line x1="12" y1="9.5" x2="12" y2="5.5" stroke="currentColor" stroke-width="1" opacity="0.4" />
            <line x1="14.2" y1="10.3" x2="17.7" y2="8.8" stroke="currentColor" stroke-width="1" opacity="0.4" />
            <line x1="14.2" y1="13.7" x2="17.7" y2="15.2" stroke="currentColor" stroke-width="1" opacity="0.4" />
            <line x1="12" y1="14.5" x2="12" y2="18.5" stroke="currentColor" stroke-width="1" opacity="0.4" />
            <line x1="9.8" y1="13.7" x2="6.3" y2="15.2" stroke="currentColor" stroke-width="1" opacity="0.4" />
            <line x1="9.8" y1="10.3" x2="6.3" y2="8.8" stroke="currentColor" stroke-width="1" opacity="0.4" />
          </svg>
        </button>
      </div>

      <script>
        function formatNumber(n: number): string {
          if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1).replace(/\.0$/, '')}M`;
          if (n >= 1_000) return `${(n / 1_000).toFixed(1).replace(/\.0$/, '')}k`;
          return n.toString();
        }

        const STORAGE_KEY = 'github-stats-collapsed';

        function isCollapsed(): boolean {
          try { return localStorage.getItem(STORAGE_KEY) === '1'; } catch { return false; }
        }

        function setCollapsed(collapsed: boolean): void {
          try { localStorage.setItem(STORAGE_KEY, collapsed ? '1' : '0'); } catch {}
        }

        function applyState(collapsed: boolean): void {
          const banner = document.getElementById('github-stats-banner');
          const toggle = document.getElementById('github-stats-toggle');
          if (!banner || !toggle) return;

          if (collapsed) {
            banner.style.transform = 'translateX(calc(100% + 24px))';
            banner.style.opacity = '0';
            banner.style.pointerEvents = 'none';
            toggle.classList.remove('hidden');
            toggle.classList.add('flex');
          } else {
            banner.style.transform = 'translateX(0)';
            banner.style.opacity = '1';
            banner.style.pointerEvents = 'auto';
            toggle.classList.add('hidden');
            toggle.classList.remove('flex');
          }
        }

        (async () => {
          try {
            const res = await fetch(`${import.meta.env.PUBLIC_API_URL}/github-stats`, { cache: 'no-store' });
            if (!res.ok) return;

            const data = await res.json();
            if (data.commits_7d === 0 && data.commits_24h === 0) return;

            const el24h = document.getElementById('stats-24h');
            const el7d = document.getElementById('stats-7d');
            const wrapper = document.getElementById('github-stats-wrapper');
            const banner = document.getElementById('github-stats-banner');
            const toggle = document.getElementById('github-stats-toggle');
            const closeBtn = document.getElementById('github-stats-close');
            if (!el24h || !el7d || !wrapper || !banner || !toggle || !closeBtn) return;

            el24h.textContent = `${formatNumber(data.commits_24h)} commits · ${formatNumber(data.lines_24h)} lines`;
            el7d.textContent = `${formatNumber(data.commits_7d)} commits · ${formatNumber(data.lines_7d)} lines`;

            // Set initial transition style
            banner.style.transition = 'transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease';

            // Apply saved state before showing
            const collapsed = isCollapsed();
            if (collapsed) {
              banner.style.transform = 'translateX(calc(100% + 24px))';
              banner.style.opacity = '0';
              banner.style.pointerEvents = 'none';
              toggle.classList.remove('hidden');
              toggle.classList.add('flex');
            }

            // Show wrapper with fade-in
            wrapper.classList.remove('hidden');
            wrapper.classList.add('flex');
            wrapper.style.opacity = '0';
            wrapper.style.transition = 'opacity 0.5s ease';
            requestAnimationFrame(() => { wrapper.style.opacity = '1'; });

            // Close button: collapse the card
            closeBtn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              setCollapsed(true);
              applyState(true);
            });

            // Toggle button: expand the card
            toggle.addEventListener('click', () => {
              setCollapsed(false);
              applyState(false);
            });
          } catch {
            // Banner stays hidden on error
          }
        })();
      </script>
    )}
  </body>
</html>
