---
import Layout from "../../layouts/Layout.astro";
import CtaBlock from "../CtaBlock.astro";
import { t, type Locale } from "../../config/site";
import { localePath } from "../../utils/i18n";

interface Props {
  locale?: Locale;
}

const locale = (Astro.props.locale || Astro.currentLocale || 'en') as Locale;
const config = t(locale);
const p = config.pages.home;

const serviceAnchor = (title: string) =>
  title.toLowerCase().replace(/[\s-]+/g, '-').replace(/[^a-z0-9-]/g, '');
---

<Layout locale={locale}>
  <!-- Hero — broadsheet front page -->
  <section id="hero" class="relative">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 pt-16 pb-12 lg:pt-28 lg:pb-20">
      <div class="chip mb-8 animate-fade-in-up opacity-0" style="animation-delay: 0.05s; animation-fill-mode: forwards;">
        <span class="w-1.5 h-1.5 rounded-full bg-rubric"></span>
        <span>{p.chip}</span>
      </div>

      <h1 class="heading-xl text-4xl sm:text-5xl lg:text-6xl xl:text-7xl text-ink max-w-5xl mb-10 animate-fade-in-up opacity-0" style="animation-delay: 0.15s; animation-fill-mode: forwards;">
        {p.headline.before}<span class="gradient-text">{p.headline.gradient}</span>
        {p.headline.after}
      </h1>

      <div class="grid lg:grid-cols-12 gap-8 animate-fade-in-up opacity-0" style="animation-delay: 0.25s; animation-fill-mode: forwards;">
        <p class="lg:col-span-6 text-lg lg:text-xl text-graphite leading-relaxed">
          {config.description}
        </p>
        <div class="lg:col-span-6 flex flex-col sm:flex-row items-start gap-4 lg:justify-end">
          <a href={localePath("/contact", locale)} class="btn-glow">{p.ctaPrimary}</a>
          <a href={localePath("/services", locale)} class="btn-secondary">{p.ctaSecondary}</a>
        </div>
      </div>
    </div>

    <!-- Live commit ticker — real data instead of a stats band -->
    <div class="border-t border-b border-rule">
      <div id="commit-ticker" class="hidden max-w-7xl mx-auto px-6 lg:px-8">
        <a
          href={localePath("/agentic-coding", locale)}
          class="flex flex-wrap items-center gap-x-6 gap-y-1 py-3 font-mono text-xs uppercase tracking-[0.06em] text-graphite hover:text-ink transition-colors duration-150"
          data-i18n-commits={config.statsBanner.commits}
          data-i18n-lines={config.statsBanner.lines}
        >
          <span class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-rubric"></span>
            {config.statsBanner.description}
          </span>
          <span>{config.statsBanner.last24h}: <span class="text-ink" id="ticker-24h"></span></span>
          <span>{config.statsBanner.last7d}: <span class="text-ink" id="ticker-7d"></span></span>
          <span class="text-rubric">{config.statsBanner.learnMore} &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Services — numbered index -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex items-baseline gap-4 mb-4">
        <span class="font-mono text-xs uppercase tracking-[0.08em] text-graphite">01 — {p.servicesSection.chip}</span>
        <div class="flex-1 h-px bg-rule"></div>
      </div>

      <div class="grid lg:grid-cols-12 gap-6 mb-14 lg:mb-20">
        <h2 class="lg:col-span-7 heading-lg text-4xl lg:text-5xl text-ink">
          {p.servicesSection.headline.before}<span class="gradient-text">{p.servicesSection.headline.gradient}</span>{p.servicesSection.headline.after}
        </h2>
        <p class="lg:col-span-5 text-graphite text-lg self-end">{p.servicesSection.description}</p>
      </div>

      <div>
        {config.services.map((service, index) => (
          <a
            href={`${localePath("/services", locale)}#${serviceAnchor(service.title)}`}
            class="group grid grid-cols-[auto_1fr] lg:grid-cols-12 gap-x-6 gap-y-2 py-8 lg:py-10 border-t border-rule last:border-b transition-colors duration-150 hover:bg-ink/[0.02]"
          >
            <span class="font-mono text-sm text-graphite pt-2 lg:col-span-1">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="heading-md text-2xl lg:text-3xl text-ink group-hover:text-rubric transition-colors duration-150 lg:col-span-5">
              {service.title}
            </h3>
            <p class="col-start-2 lg:col-start-auto lg:col-span-4 text-graphite text-sm leading-relaxed">
              {service.description}
            </p>
            <span class="col-start-2 lg:col-start-auto lg:col-span-2 font-mono text-xs uppercase tracking-[0.06em] text-graphite lg:text-right">
              {service.features.slice(0, 2).join(' · ')}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Apps — ruled list of real products -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex items-baseline gap-4 mb-4">
        <span class="font-mono text-xs uppercase tracking-[0.08em] text-graphite">02 — {p.appsSection.chip}</span>
        <div class="flex-1 h-px bg-rule"></div>
      </div>

      <div class="grid lg:grid-cols-12 gap-6 mb-14 lg:mb-20">
        <h2 class="lg:col-span-7 heading-lg text-4xl lg:text-5xl text-ink">
          {p.appsSection.headline.before}<span class="gradient-text">{p.appsSection.headline.gradient}</span>{p.appsSection.headline.after}
        </h2>
        <p class="lg:col-span-5 text-graphite text-lg self-end">{p.appsSection.description}</p>
      </div>

      <div class="grid md:grid-cols-3 gap-x-10">
        {config.apps.map((app) => {
          const isLive = app.status === "live" && app.link;
          const Tag = isLive ? "a" : "div";
          return (
            <Tag
              {...(isLive ? { href: app.link!, target: "_blank", rel: "noopener noreferrer" } : {})}
              class:list={["group border-t border-rule pt-6 pb-10", isLive && "cursor-pointer"]}
            >
              <div class="flex items-center gap-3 mb-4">
                <img
                  src={app.icon}
                  alt=""
                  width="52"
                  height="52"
                  loading="lazy"
                  decoding="async"
                  class="w-9 h-9 rounded-sm"
                />
                <h3 class:list={[
                  "heading-md text-xl text-ink",
                  isLive && "group-hover:text-rubric transition-colors duration-150",
                ]}>{app.title}</h3>
                {app.status === "coming-soon" && (
                  <span class="font-mono text-[0.65rem] uppercase tracking-[0.08em] text-graphite border border-rule px-1.5 py-0.5">Coming Soon</span>
                )}
              </div>

              <p class="text-graphite text-sm leading-relaxed mb-4">{app.description}</p>

              {isLive && (
                <span class="font-mono text-xs uppercase tracking-[0.06em] text-rubric">
                  Open App &rarr;
                </span>
              )}
            </Tag>
          );
        })}
      </div>

      <div class="mt-10">
        <a href={p.appsSection.linkUrl} class="font-mono text-xs uppercase tracking-[0.06em] text-rubric hover:text-ink transition-colors duration-150">
          {p.appsSection.linkText} &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex items-baseline gap-4 mb-14 lg:mb-20">
        <span class="font-mono text-xs uppercase tracking-[0.08em] text-graphite">03 — {p.philosophySection.chip}</span>
        <div class="flex-1 h-px bg-rule"></div>
      </div>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20">
        <div>
          <h2 class="heading-lg text-4xl lg:text-5xl text-ink mb-8">
            {p.philosophySection.headline.before}<br/>
            <span class="gradient-text">{p.philosophySection.headline.gradient}</span>{p.philosophySection.headline.after}
          </h2>
          <p class="text-graphite text-lg leading-relaxed mb-8">{config.about.story}</p>
          <a href={localePath("/about", locale)} class="btn-secondary">
            {p.philosophySection.linkText}
          </a>
        </div>

        <div>
          {config.about.values.map((value, index) => (
            <div class="grid grid-cols-[auto_1fr] gap-5 py-6 border-t border-rule last:border-b">
              <span class="font-mono text-sm text-graphite pt-1">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="heading-md text-lg text-ink mb-1.5">{value.title}</h3>
                <p class="text-graphite text-sm leading-relaxed">{value.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CtaBlock
    headline={p.cta.headline}
    description={p.cta.description}
    button={p.cta.button}
    href={localePath("/contact", locale)}
  />
</Layout>

<script>
  // Live commit ticker — same data the agentic-coding page shows.
  (async () => {
    try {
      const res = await fetch(`${import.meta.env.PUBLIC_API_URL}/github-stats`, { cache: 'no-store' });
      if (!res.ok) return;
      const data = await res.json();
      if (data.commits_24h === 0 && data.commits_7d === 0) return;

      const ticker = document.getElementById('commit-ticker');
      const el24h = document.getElementById('ticker-24h');
      const el7d = document.getElementById('ticker-7d');
      const link = ticker?.querySelector('a');
      if (!ticker || !el24h || !el7d) return;

      const fmt = (n: number) =>
        n >= 1_000_000 ? `${(n / 1_000_000).toFixed(1).replace(/\.0$/, '')}M`
        : n >= 1_000 ? `${(n / 1_000).toFixed(1).replace(/\.0$/, '')}k`
        : n.toString();

      const commitsLabel = link?.dataset.i18nCommits || 'commits';
      const linesLabel = link?.dataset.i18nLines || 'lines';
      el24h.textContent = `${fmt(data.commits_24h)} ${commitsLabel} · ${fmt(data.lines_24h)} ${linesLabel}`;
      el7d.textContent = `${fmt(data.commits_7d)} ${commitsLabel} · ${fmt(data.lines_7d)} ${linesLabel}`;
      ticker.classList.remove('hidden');
    } catch {
      // Ticker stays hidden on error
    }
  })();
</script>
