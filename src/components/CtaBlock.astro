---
// The single ink block per page — dark is reserved for this CTA moment.
interface Props {
  headline: string;
  description: string;
  button: string;
  href: string;
}

const { headline, description, button, href } = Astro.props;
---

<section class="py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="bg-ink px-8 py-14 lg:px-16 lg:py-20">
      <div class="max-w-3xl">
        <h2 class="heading-xl text-4xl lg:text-5xl text-paper mb-5 whitespace-pre-line">{headline}</h2>
        <p class="text-paper/70 text-lg mb-10">{description}</p>
        <a href={href} class="btn-primary">{button}</a>
        <slot />
      </div>
    </div>
  </div>
</section>
