---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../Breadcrumbs.astro";
import CtaBlock from "../CtaBlock.astro";
import { t, type Locale } from "../../config/site";
import { localePath } from "../../utils/i18n";
import { getCollection } from "astro:content";

const locale = (Astro.currentLocale || 'en') as Locale;
const config = t(locale);
const p = config.pages.blog;

// ── Read articles from Content Collections ────────────────────────
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

const [lead, ...rest] = posts;

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
}

function postUrl(post: { id: string }): string {
  return `/blog/${post.id}/`;
}

// JSON-LD Blog schema
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: `${config.name} Blog`,
  description: p.meta.description,
  url: "https://www.creative-it.com/blog/",
  publisher: {
    "@type": "Organization",
    name: config.name,
    url: "https://www.creative-it.com",
  },
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.metaDescription ?? post.data.brief,
    url: `https://www.creative-it.com/blog/${post.id}/`,
    datePublished: post.data.publishedAt.toISOString(),
    dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
    ...(post.data.coverImage && {
      image: `https://www.creative-it.com${post.data.coverImage}`,
    }),
    author: {
      "@type": "Person",
      "@id": "https://www.creative-it.com/#person",
      name: "Günther Wieser",
    },
  })),
};
---

<Layout title={p.meta.title} description={p.meta.description}>
  <Breadcrumbs items={[{ name: p.meta.title }]} locale={locale} />
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />

  <!-- Hero -->
  <section class="relative py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="chip mb-6 animate-fade-in-up opacity-0" style="animation-delay: 0.1s; animation-fill-mode: forwards;">
          <span>{p.hero.chip}</span>
        </div>
        <h1 class="heading-xl text-5xl lg:text-6xl xl:text-7xl text-ink mb-6 animate-fade-in-up opacity-0" style="animation-delay: 0.2s; animation-fill-mode: forwards;">
          {p.hero.headline.before}<span class="gradient-text">{p.hero.headline.gradient}</span>{p.hero.headline.after}
        </h1>
        <p class="text-lg text-graphite leading-relaxed animate-fade-in-up opacity-0" style="animation-delay: 0.3s; animation-fill-mode: forwards;">
          {p.hero.description}
        </p>
      </div>
    </div>
  </section>

  <!-- Articles — feuilleton -->
  <section class="pb-20 lg:pb-28">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      {posts.length === 0 ? (
        <p class="text-graphite text-lg">No articles found. Check back soon!</p>
      ) : (
        <>
          <!-- Lead article -->
          <a href={postUrl(lead)} class="group grid lg:grid-cols-12 gap-x-8 gap-y-6 py-12 lg:py-16 border-t border-rule">
            <div class="lg:col-span-7">
              <div class="flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs uppercase tracking-[0.06em] text-graphite mb-5">
                <time datetime={lead.data.publishedAt.toISOString().slice(0, 10)}>{formatDate(lead.data.publishedAt)}</time>
                {lead.data.readTimeInMinutes > 0 && <span>{lead.data.readTimeInMinutes} min</span>}
                <span>Günther Wieser</span>
              </div>
              <h2 class="heading-lg text-3xl lg:text-5xl text-ink group-hover:text-rubric transition-colors duration-150 mb-5">
                {lead.data.title}
              </h2>
              <p class="text-graphite text-lg leading-relaxed mb-6 max-w-[60ch]">{lead.data.brief}</p>
              {lead.data.tags.length > 0 && (
                <div class="font-mono text-xs uppercase tracking-[0.06em] text-graphite">
                  {lead.data.tags.slice(0, 3).join(' · ')}
                </div>
              )}
            </div>
            {lead.data.coverImage && (
              <div class="lg:col-span-5">
                <img
                  src={lead.data.coverImage}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="w-full h-auto border border-rule"
                />
              </div>
            )}
          </a>

          <!-- Remaining articles as ruled list -->
          {rest.map((post) => (
            <a href={postUrl(post)} class="group grid lg:grid-cols-12 gap-x-8 gap-y-2 py-8 lg:py-10 border-t border-rule last:border-b">
              <div class="lg:col-span-3 flex flex-wrap lg:flex-col gap-x-4 gap-y-1 font-mono text-xs uppercase tracking-[0.06em] text-graphite">
                <time datetime={post.data.publishedAt.toISOString().slice(0, 10)}>{formatDate(post.data.publishedAt)}</time>
                {post.data.readTimeInMinutes > 0 && <span>{post.data.readTimeInMinutes} min</span>}
              </div>
              <div class="lg:col-span-9">
                <h2 class="heading-md text-2xl lg:text-3xl text-ink group-hover:text-rubric transition-colors duration-150 mb-3">
                  {post.data.title}
                </h2>
                <p class="text-graphite leading-relaxed max-w-[70ch] mb-3">{post.data.brief}</p>
                {post.data.tags.length > 0 && (
                  <div class="font-mono text-xs uppercase tracking-[0.06em] text-graphite">
                    {post.data.tags.slice(0, 3).join(' · ')}
                  </div>
                )}
              </div>
            </a>
          ))}
        </>
      )}
    </div>
  </section>

  <CtaBlock
    headline={p.cta.headline}
    description={p.cta.description}
    button={p.cta.button}
    href={localePath("/contact", locale)}
  />
</Layout>
