---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../Breadcrumbs.astro";
import CtaBlock from "../CtaBlock.astro";
import { t, type Locale } from "../../config/site";
import { localePath } from "../../utils/i18n";
const locale = (Astro.currentLocale || 'en') as Locale;
const config = t(locale);
const p = config.pages.services;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: config.services.map((service, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "Service",
      name: service.title,
      description: service.description,
      provider: {
        "@type": "Organization",
        name: "creative-it Software Consulting e.U.",
      },
    },
  })),
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: config.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};

const serviceAnchor = (title: string) =>
  title.toLowerCase().replace(/[\s-]+/g, '-').replace(/[^a-z0-9-]/g, '');
---

<Layout title={p.meta.title} description={p.meta.description}>
  <Breadcrumbs items={[{ name: p.meta.title }]} locale={locale} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <section class="relative py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="chip mb-6 animate-fade-in-up opacity-0" style="animation-delay: 0.1s; animation-fill-mode: forwards;">
          <span>{p.hero.chip}</span>
        </div>
        <h1 class="heading-xl text-5xl lg:text-6xl xl:text-7xl text-ink mb-6 animate-fade-in-up opacity-0" style="animation-delay: 0.2s; animation-fill-mode: forwards;">
          {p.hero.headline.before}<span class="gradient-text">{p.hero.headline.gradient}</span>{p.hero.headline.after}
        </h1>
        <p class="text-lg text-graphite leading-relaxed animate-fade-in-up opacity-0" style="animation-delay: 0.3s; animation-fill-mode: forwards;">
          {p.hero.description}
        </p>
      </div>
    </div>
  </section>

  <!-- Services Index -->
  <section class="pb-20 lg:pb-28">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      {config.services.map((service, index) => (
        <article
          id={serviceAnchor(service.title)}
          class="grid lg:grid-cols-12 gap-x-8 gap-y-6 py-12 lg:py-16 border-t border-rule last:border-b scroll-mt-24"
        >
          <div class="lg:col-span-1">
            <span class="font-serif text-4xl lg:text-5xl text-rule">{String(index + 1).padStart(2, '0')}</span>
          </div>

          <div class="lg:col-span-6">
            <h2 class="heading-lg text-3xl lg:text-4xl text-ink mb-4">{service.title}</h2>
            <p class="text-graphite text-lg leading-relaxed mb-6">{service.description}</p>
            <a href={localePath(`/services/${service.slug}`, locale)} class="font-mono text-xs uppercase tracking-[0.06em] text-rubric hover:text-ink transition-colors duration-150">
              {locale === 'de' ? 'Mehr erfahren' : 'Learn more'} &rarr;
            </a>
          </div>

          <div class="lg:col-span-4 lg:col-start-9">
            <h3 class="label mb-4">{locale === 'de' ? 'Leistungen' : 'Includes'}</h3>
            <ul>
              {service.features.map((feature) => (
                <li class="py-2 border-t border-rule text-sm text-graphite">{feature}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex items-baseline gap-4 mb-4">
        <span class="font-mono text-xs uppercase tracking-[0.08em] text-graphite">{p.processSection.chip}</span>
        <div class="flex-1 h-px bg-rule"></div>
      </div>

      <div class="grid lg:grid-cols-12 gap-6 mb-14 lg:mb-20">
        <h2 class="lg:col-span-6 heading-lg text-4xl lg:text-5xl text-ink">{p.processSection.headline}</h2>
        <p class="lg:col-span-6 text-graphite text-lg self-end">{p.processSection.description}</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-x-10 gap-y-8">
        {config.process.map((item) => (
          <div class="border-t border-rule pt-5">
            <div class="font-mono text-sm text-graphite mb-3">{item.step}</div>
            <h3 class="heading-md text-xl text-ink mb-2">{item.title}</h3>
            <p class="text-graphite text-sm leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBlock
    headline={p.cta.headline}
    description={p.cta.description}
    button={p.cta.button}
    href={localePath("/contact", locale)}
  />
</Layout>
