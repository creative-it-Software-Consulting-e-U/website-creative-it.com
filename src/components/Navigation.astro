---
import { t, type Locale } from "../config/site";
import { localePath, getAlternateLocale } from "../utils/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale || (Astro.currentLocale as Locale) || 'en';
const config = t(locale);
const currentPath = Astro.url.pathname;
const altLocale = getAlternateLocale(locale);

// Build the alternate path for the language switcher
const switchPath = localePath(currentPath, altLocale);
const switchLabel = locale === 'en' ? 'DE' : 'EN';
const contactPath = localePath('/contact', locale);
const ctaLabel = locale === 'de' ? 'Kontakt' : 'Get in Touch';

const isActive = (item: { href: string; children?: { href: string }[] }) =>
  currentPath === item.href ||
  item.children?.some(child => currentPath === child.href);
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-transparent" id="nav-header">
  <nav class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex justify-between items-center h-16 lg:h-20">
      <!-- Logo -->
      <a href={localePath('/', locale)} class="relative z-10 flex items-center gap-3 group">
        <picture>
          <source srcset="/logo-dark.webp" type="image/webp" />
          <img
            src="/logo-dark.png"
            alt={config.name}
            width="1457"
            height="988"
            fetchpriority="high"
            class="h-14 lg:h-[4.5rem] w-auto py-2 transition-transform duration-300 group-hover:scale-105"
          />
        </picture>
      </a>

      <!-- Desktop Navigation -->
      <ul class="hidden lg:flex items-center gap-3 xl:gap-5">
        {config.navigation.map((item) => (
          <li class={item.children ? "relative group" : ""}>
            {item.children ? (
              <>
                <span
                  class:list={[
                    "relative text-xs xl:text-sm font-medium transition-colors duration-200 whitespace-nowrap inline-flex items-center gap-1 cursor-default",
                    isActive(item)
                      ? "text-off-white"
                      : "text-text-muted group-hover:text-off-white",
                  ]}
                >
                  {item.name}
                  <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                  {isActive(item) && (
                    <span class="absolute -bottom-1 left-0 w-full h-0.5 bg-gradient-to-r from-purple to-cyan rounded-full"></span>
                  )}
                </span>
                <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-1 group-hover:translate-y-0">
                  <ul class="bg-surface border border-white/10 rounded-xl py-2 px-1 min-w-[180px] shadow-xl shadow-black/30">
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class:list={[
                            "block px-4 py-2 text-sm rounded-lg transition-colors duration-150",
                            currentPath === child.href
                              ? "text-off-white bg-white/5"
                              : "text-text-muted hover:text-off-white hover:bg-white/5",
                          ]}
                        >
                          {child.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </>
            ) : (
              <a
                href={item.href}
                class:list={[
                  "relative text-xs xl:text-sm font-medium transition-colors duration-200 whitespace-nowrap",
                  currentPath === item.href
                    ? "text-off-white"
                    : "text-text-muted hover:text-off-white",
                ]}
              >
                {item.name}
                {currentPath === item.href && (
                  <span class="absolute -bottom-1 left-0 w-full h-0.5 bg-gradient-to-r from-purple to-cyan rounded-full"></span>
                )}
              </a>
            )}
          </li>
        ))}
      </ul>

      <!-- Language Switcher + CTA (Desktop) -->
      <div class="hidden lg:flex items-center gap-4">
        <a
          href={switchPath}
          class="lang-switch flex items-center gap-1.5 text-sm font-medium text-text-muted hover:text-off-white transition-colors duration-200"
          title={altLocale === 'de' ? 'Auf Deutsch wechseln' : 'Switch to English'}
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3" /></svg>
          {switchLabel}
        </a>
        <a href={contactPath} class="btn-glow text-sm">
          {ctaLabel}
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="lg:hidden relative z-10 w-10 h-10 flex flex-col justify-center items-center gap-1.5 group"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span class="hamburger-line w-6 h-0.5 bg-off-white transition-all duration-300 origin-center"></span>
        <span class="hamburger-line w-6 h-0.5 bg-off-white transition-all duration-300"></span>
        <span class="hamburger-line w-6 h-0.5 bg-off-white transition-all duration-300 origin-center"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="lg:hidden fixed inset-0 bg-navy opacity-0 invisible pointer-events-none transition-all duration-500 flex items-center justify-center"
  >
    <nav class="text-center">
      <ul class="space-y-8">
        {config.navigation.map((item, index) => (
          <li
            class="mobile-nav-item opacity-0 translate-y-4"
            style={`transition-delay: ${index * 100}ms`}
          >
            {item.children ? (
              <>
                <button
                  class:list={[
                    "mobile-dropdown-toggle heading-lg text-4xl sm:text-5xl transition-colors duration-300 inline-flex items-center gap-2",
                    isActive(item)
                      ? "gradient-text"
                      : "text-off-white hover:text-purple",
                  ]}
                  data-dropdown={`mobile-dropdown-${index}`}
                >
                  {item.name}
                  <svg class="w-6 h-6 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
                <ul
                  id={`mobile-dropdown-${index}`}
                  class="mobile-dropdown mt-4 space-y-3 max-h-0 overflow-hidden transition-all duration-300"
                >
                  {item.children.map((child, childIndex) => (
                    <li
                      class="opacity-0 translate-y-2 transition-all duration-300"
                      style={`transition-delay: ${childIndex * 75}ms`}
                    >
                      <a
                        href={child.href}
                        class:list={[
                          "text-xl sm:text-2xl transition-colors duration-300",
                          currentPath === child.href
                            ? "gradient-text"
                            : "text-text-muted hover:text-off-white",
                        ]}
                      >
                        {child.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            ) : (
              <a
                href={item.href}
                class:list={[
                  "heading-lg text-4xl sm:text-5xl transition-colors duration-300",
                  currentPath === item.href
                    ? "gradient-text"
                    : "text-off-white hover:text-purple",
                ]}
              >
                {item.name}
              </a>
            )}
          </li>
        ))}
      </ul>

      <div class="mt-8 mobile-nav-item opacity-0 translate-y-4" style={`transition-delay: ${config.navigation.length * 100}ms`}>
        <a
          href={switchPath}
          class="lang-switch inline-flex items-center gap-2 text-lg text-text-muted hover:text-off-white transition-colors duration-200"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3" /></svg>
          {altLocale === 'de' ? 'Deutsch' : 'English'}
        </a>
      </div>

      <div class="mt-6 mobile-nav-item opacity-0 translate-y-4" style={`transition-delay: ${(config.navigation.length + 1) * 100}ms`}>
        <a href={contactPath} class="btn-glow">
          {ctaLabel}
        </a>
      </div>
    </nav>
  </div>
</header>

<!-- Spacer to account for fixed header -->
<div class="h-16 lg:h-20"></div>

<script>
  const header = document.getElementById('nav-header');
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const hamburgerLines = button?.querySelectorAll('.hamburger-line');
  const mobileNavItems = document.querySelectorAll('.mobile-nav-item');
  let isOpen = false;

  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;

    if (currentScroll > 50) {
      header?.classList.add('bg-navy/95', 'border-white/5');
      header?.classList.remove('border-transparent');
    } else {
      header?.classList.remove('bg-navy/95', 'border-white/5');
      header?.classList.add('border-transparent');
    }
  });

  button?.addEventListener('click', () => {
    isOpen = !isOpen;
    button.setAttribute('aria-expanded', isOpen.toString());

    if (isOpen) {
      menu?.classList.remove('opacity-0', 'invisible', 'pointer-events-none');
      menu?.classList.add('opacity-100', 'visible', 'pointer-events-auto');
      document.body.style.overflow = 'hidden';

      if (hamburgerLines) {
        hamburgerLines[0].classList.add('rotate-45', 'translate-y-2');
        hamburgerLines[1].classList.add('opacity-0');
        hamburgerLines[2].classList.add('-rotate-45', '-translate-y-2');
      }

      mobileNavItems.forEach((item, index) => {
        setTimeout(() => {
          item.classList.remove('opacity-0', 'translate-y-4');
          item.classList.add('opacity-100', 'translate-y-0');
        }, index * 100);
      });
    } else {
      menu?.classList.add('opacity-0', 'invisible', 'pointer-events-none');
      menu?.classList.remove('opacity-100', 'visible', 'pointer-events-auto');
      document.body.style.overflow = '';

      if (hamburgerLines) {
        hamburgerLines[0].classList.remove('rotate-45', 'translate-y-2');
        hamburgerLines[1].classList.remove('opacity-0');
        hamburgerLines[2].classList.remove('-rotate-45', '-translate-y-2');
      }

      mobileNavItems.forEach((item) => {
        item.classList.add('opacity-0', 'translate-y-4');
        item.classList.remove('opacity-100', 'translate-y-0');
      });

      // Close all mobile dropdowns when menu closes
      document.querySelectorAll('.mobile-dropdown').forEach(dropdown => {
        dropdown.classList.remove('max-h-96');
        dropdown.classList.add('max-h-0');
        dropdown.querySelectorAll('li').forEach(li => {
          li.classList.add('opacity-0', 'translate-y-2');
          li.classList.remove('opacity-100', 'translate-y-0');
        });
      });
      document.querySelectorAll('.mobile-dropdown-toggle svg').forEach(svg => {
        svg.classList.remove('rotate-180');
      });
    }
  });

  // Mobile dropdown accordion toggles
  document.querySelectorAll('.mobile-dropdown-toggle').forEach(toggle => {
    toggle.addEventListener('click', () => {
      const targetId = toggle.getAttribute('data-dropdown');
      if (!targetId) return;
      const dropdown = document.getElementById(targetId);
      if (!dropdown) return;

      const isExpanded = dropdown.classList.contains('max-h-96');
      const chevron = toggle.querySelector('svg');

      if (isExpanded) {
        dropdown.classList.remove('max-h-96');
        dropdown.classList.add('max-h-0');
        chevron?.classList.remove('rotate-180');
        dropdown.querySelectorAll('li').forEach(li => {
          li.classList.add('opacity-0', 'translate-y-2');
          li.classList.remove('opacity-100', 'translate-y-0');
        });
      } else {
        dropdown.classList.remove('max-h-0');
        dropdown.classList.add('max-h-96');
        chevron?.classList.add('rotate-180');
        dropdown.querySelectorAll('li').forEach((li, i) => {
          setTimeout(() => {
            li.classList.remove('opacity-0', 'translate-y-2');
            li.classList.add('opacity-100', 'translate-y-0');
          }, i * 75);
        });
      }
    });
  });

  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      if (isOpen) {
        button?.click();
      }
    });
  });

  // Set locale cookie when language switcher is clicked
  document.querySelectorAll('.lang-switch').forEach(link => {
    link.addEventListener('click', () => {
      const href = link.getAttribute('href') || '/';
      const targetLocale = href.startsWith('/de') ? 'de' : 'en';
      document.cookie = `locale=${targetLocale}; path=/; max-age=31536000; SameSite=Lax`;
    });
  });

  // Close mobile menu on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      button?.click();
      button?.focus();
    }
  });

  // Focus trap within mobile menu when open
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || !isOpen || !menu) return;

    const focusableEls = menu.querySelectorAll<HTMLElement>(
      'a[href], button, [tabindex]:not([tabindex="-1"])'
    );
    if (focusableEls.length === 0) return;

    const firstEl = focusableEls[0];
    const lastEl = focusableEls[focusableEls.length - 1];

    if (e.shiftKey) {
      if (document.activeElement === firstEl || document.activeElement === button) {
        e.preventDefault();
        lastEl.focus();
      }
    } else {
      if (document.activeElement === lastEl) {
        e.preventDefault();
        firstEl.focus();
      }
    }
  });
</script>

<style>
  .mobile-nav-item {
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
</style>
