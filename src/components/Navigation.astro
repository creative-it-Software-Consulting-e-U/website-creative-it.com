---
import { t, type Locale } from "../config/site";
import { localePath, getAlternateLocale } from "../utils/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale || (Astro.currentLocale as Locale) || 'en';
const config = t(locale);
const currentPath = Astro.url.pathname;
const altLocale = getAlternateLocale(locale);

// Build the alternate path for the language switcher
const switchPath = localePath(currentPath, altLocale);
const switchLabel = locale === 'en' ? 'DE' : 'EN';
const contactPath = localePath('/contact', locale);
const ctaLabel = locale === 'de' ? 'Kontakt' : 'Get in Touch';

const isActive = (item: { href: string; children?: { href: string }[] }) =>
  currentPath === item.href ||
  item.children?.some(child => currentPath === child.href);
---

<header class="fixed top-0 left-0 right-0 z-50 bg-paper border-b-2 border-ink" id="nav-header">
  <nav class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex justify-between items-center h-16 lg:h-20">
      <!-- Logo -->
      <a href={localePath('/', locale)} class="relative z-10 flex items-center gap-2.5 group">
        <img
          src="/logo-only.webp"
          alt=""
          width="504"
          height="548"
          fetchpriority="high"
          class="h-8 lg:h-9 w-auto"
        />
        <span class="font-serif text-xl lg:text-2xl text-ink tracking-tight">creative-it<span class="text-rubric">.</span></span>
      </a>

      <!-- Desktop Navigation -->
      <ul class="hidden lg:flex items-center gap-5 xl:gap-7">
        {config.navigation.map((item, index) => (
          <li class={item.children ? "relative" : ""} data-nav-dropdown={item.children ? "" : undefined}>
            {item.children ? (
              <>
                <button
                  type="button"
                  aria-expanded="false"
                  aria-controls={`nav-dropdown-${index}`}
                  class:list={[
                    "nav-dropdown-toggle font-mono text-[0.8125rem] uppercase tracking-[0.08em] transition-colors duration-150 whitespace-nowrap inline-flex items-center gap-1.5 cursor-pointer",
                    isActive(item) ? "text-rubric" : "text-graphite hover:text-ink",
                  ]}
                >
                  {item.name}
                  <svg class="nav-dropdown-chevron w-3 h-3 transition-transform duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
                <div id={`nav-dropdown-${index}`} class="nav-dropdown-panel absolute top-full left-0 pt-3 hidden">
                  <ul class="bg-paper border border-rule min-w-[230px] py-1.5 shadow-[0_8px_24px_rgba(28,27,26,0.08)]">
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class:list={[
                            "block px-4 py-2 font-mono text-[0.8125rem] uppercase tracking-[0.06em] transition-colors duration-150",
                            currentPath === child.href
                              ? "text-rubric"
                              : "text-graphite hover:text-ink hover:bg-ink/[0.03]",
                          ]}
                        >
                          {child.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </>
            ) : (
              <a
                href={item.href}
                class:list={[
                  "font-mono text-[0.8125rem] uppercase tracking-[0.08em] transition-colors duration-150 whitespace-nowrap",
                  currentPath === item.href ? "text-rubric" : "text-graphite hover:text-ink",
                ]}
              >
                {item.name}
              </a>
            )}
          </li>
        ))}
      </ul>

      <!-- Language Switcher + CTA (Desktop) -->
      <div class="hidden lg:flex items-center gap-5">
        <a
          href={switchPath}
          class="lang-switch font-mono text-[0.8125rem] uppercase tracking-[0.08em] text-graphite hover:text-ink transition-colors duration-150"
          title={altLocale === 'de' ? 'Auf Deutsch wechseln' : 'Switch to English'}
        >
          {switchLabel}
        </a>
        <a href={contactPath} class="btn-glow text-sm !py-2.5 !px-5">
          {ctaLabel}
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="lg:hidden relative z-10 w-10 h-10 flex flex-col justify-center items-center gap-1.5 group"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span class="hamburger-line w-6 h-0.5 bg-ink transition-all duration-300 origin-center"></span>
        <span class="hamburger-line w-6 h-0.5 bg-ink transition-all duration-300"></span>
        <span class="hamburger-line w-6 h-0.5 bg-ink transition-all duration-300 origin-center"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="lg:hidden fixed inset-0 bg-paper opacity-0 invisible pointer-events-none transition-all duration-300 flex items-center justify-center"
  >
    <nav class="text-center">
      <ul class="space-y-7">
        {config.navigation.map((item, index) => (
          <li
            class="mobile-nav-item opacity-0 translate-y-4"
            style={`transition-delay: ${index * 75}ms`}
          >
            {item.children ? (
              <>
                <button
                  class:list={[
                    "mobile-dropdown-toggle heading-lg text-4xl sm:text-5xl transition-colors duration-300 inline-flex items-center gap-2",
                    isActive(item) ? "text-rubric" : "text-ink",
                  ]}
                  data-dropdown={`mobile-dropdown-${index}`}
                  aria-expanded="false"
                >
                  {item.name}
                  <svg class="w-6 h-6 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
                <ul
                  id={`mobile-dropdown-${index}`}
                  class="mobile-dropdown mt-4 space-y-3 max-h-0 overflow-hidden transition-all duration-300"
                >
                  {item.children.map((child, childIndex) => (
                    <li
                      class="opacity-0 translate-y-2 transition-all duration-300"
                      style={`transition-delay: ${childIndex * 50}ms`}
                    >
                      <a
                        href={child.href}
                        class:list={[
                          "font-mono text-base uppercase tracking-[0.06em] transition-colors duration-300",
                          currentPath === child.href ? "text-rubric" : "text-graphite hover:text-ink",
                        ]}
                      >
                        {child.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            ) : (
              <a
                href={item.href}
                class:list={[
                  "heading-lg text-4xl sm:text-5xl transition-colors duration-300",
                  currentPath === item.href ? "text-rubric" : "text-ink",
                ]}
              >
                {item.name}
              </a>
            )}
          </li>
        ))}
      </ul>

      <div class="mt-8 mobile-nav-item opacity-0 translate-y-4" style={`transition-delay: ${config.navigation.length * 75}ms`}>
        <a
          href={switchPath}
          class="lang-switch inline-flex items-center gap-2 font-mono text-sm uppercase tracking-[0.08em] text-graphite hover:text-ink transition-colors duration-200"
        >
          {altLocale === 'de' ? 'Deutsch' : 'English'}
        </a>
      </div>

      <div class="mt-6 mobile-nav-item opacity-0 translate-y-4" style={`transition-delay: ${(config.navigation.length + 1) * 75}ms`}>
        <a href={contactPath} class="btn-glow">
          {ctaLabel}
        </a>
      </div>
    </nav>
  </div>
</header>

<!-- Spacer to account for fixed header -->
<div class="h-16 lg:h-20"></div>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const hamburgerLines = button?.querySelectorAll('.hamburger-line');
  const mobileNavItems = document.querySelectorAll('.mobile-nav-item');
  let isOpen = false;

  // Desktop dropdowns — click to open (keyboard accessible), close on
  // outside click or Escape. Only one open at a time.
  const dropdownToggles = document.querySelectorAll<HTMLButtonElement>('.nav-dropdown-toggle');

  function closeDropdown(toggle: HTMLButtonElement) {
    const panel = document.getElementById(toggle.getAttribute('aria-controls') || '');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.querySelector('.nav-dropdown-chevron')?.classList.remove('rotate-180');
    panel?.classList.add('hidden');
  }

  function closeAllDropdowns() {
    dropdownToggles.forEach(closeDropdown);
  }

  dropdownToggles.forEach((toggle) => {
    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const wasOpen = toggle.getAttribute('aria-expanded') === 'true';
      closeAllDropdowns();
      if (!wasOpen) {
        const panel = document.getElementById(toggle.getAttribute('aria-controls') || '');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.querySelector('.nav-dropdown-chevron')?.classList.add('rotate-180');
        panel?.classList.remove('hidden');
      }
    });
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as Element)?.closest('[data-nav-dropdown]')) {
      closeAllDropdowns();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const openToggle = Array.from(dropdownToggles).find(
        (t) => t.getAttribute('aria-expanded') === 'true'
      );
      if (openToggle) {
        closeAllDropdowns();
        openToggle.focus();
      }
    }
  });

  button?.addEventListener('click', () => {
    isOpen = !isOpen;
    button.setAttribute('aria-expanded', isOpen.toString());

    if (isOpen) {
      menu?.classList.remove('opacity-0', 'invisible', 'pointer-events-none');
      menu?.classList.add('opacity-100', 'visible', 'pointer-events-auto');
      document.body.style.overflow = 'hidden';

      if (hamburgerLines) {
        hamburgerLines[0].classList.add('rotate-45', 'translate-y-2');
        hamburgerLines[1].classList.add('opacity-0');
        hamburgerLines[2].classList.add('-rotate-45', '-translate-y-2');
      }

      mobileNavItems.forEach((item, index) => {
        setTimeout(() => {
          item.classList.remove('opacity-0', 'translate-y-4');
          item.classList.add('opacity-100', 'translate-y-0');
        }, index * 75);
      });
    } else {
      menu?.classList.add('opacity-0', 'invisible', 'pointer-events-none');
      menu?.classList.remove('opacity-100', 'visible', 'pointer-events-auto');
      document.body.style.overflow = '';

      if (hamburgerLines) {
        hamburgerLines[0].classList.remove('rotate-45', 'translate-y-2');
        hamburgerLines[1].classList.remove('opacity-0');
        hamburgerLines[2].classList.remove('-rotate-45', '-translate-y-2');
      }

      mobileNavItems.forEach((item) => {
        item.classList.add('opacity-0', 'translate-y-4');
        item.classList.remove('opacity-100', 'translate-y-0');
      });

      // Close all mobile dropdowns when menu closes
      document.querySelectorAll('.mobile-dropdown').forEach(dropdown => {
        dropdown.classList.remove('max-h-96');
        dropdown.classList.add('max-h-0');
        dropdown.querySelectorAll('li').forEach(li => {
          li.classList.add('opacity-0', 'translate-y-2');
          li.classList.remove('opacity-100', 'translate-y-0');
        });
      });
      document.querySelectorAll('.mobile-dropdown-toggle').forEach(t => {
        t.setAttribute('aria-expanded', 'false');
        t.querySelector('svg')?.classList.remove('rotate-180');
      });
    }
  });

  // Mobile dropdown accordion toggles
  document.querySelectorAll('.mobile-dropdown-toggle').forEach(toggle => {
    toggle.addEventListener('click', () => {
      const targetId = toggle.getAttribute('data-dropdown');
      if (!targetId) return;
      const dropdown = document.getElementById(targetId);
      if (!dropdown) return;

      const isExpanded = dropdown.classList.contains('max-h-96');
      const chevron = toggle.querySelector('svg');
      toggle.setAttribute('aria-expanded', (!isExpanded).toString());

      if (isExpanded) {
        dropdown.classList.remove('max-h-96');
        dropdown.classList.add('max-h-0');
        chevron?.classList.remove('rotate-180');
        dropdown.querySelectorAll('li').forEach(li => {
          li.classList.add('opacity-0', 'translate-y-2');
          li.classList.remove('opacity-100', 'translate-y-0');
        });
      } else {
        dropdown.classList.remove('max-h-0');
        dropdown.classList.add('max-h-96');
        chevron?.classList.add('rotate-180');
        dropdown.querySelectorAll('li').forEach((li, i) => {
          setTimeout(() => {
            li.classList.remove('opacity-0', 'translate-y-2');
            li.classList.add('opacity-100', 'translate-y-0');
          }, i * 50);
        });
      }
    });
  });

  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      if (isOpen) {
        button?.click();
      }
    });
  });

  // Set locale cookie when language switcher is clicked
  document.querySelectorAll('.lang-switch').forEach(link => {
    link.addEventListener('click', () => {
      const href = link.getAttribute('href') || '/';
      const targetLocale = href.startsWith('/de') ? 'de' : 'en';
      document.cookie = `locale=${targetLocale}; path=/; max-age=31536000; SameSite=Lax`;
    });
  });

  // Close mobile menu on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      button?.click();
      button?.focus();
    }
  });

  // Focus trap within mobile menu when open
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || !isOpen || !menu) return;

    const focusableEls = menu.querySelectorAll<HTMLElement>(
      'a[href], button, [tabindex]:not([tabindex="-1"])'
    );
    if (focusableEls.length === 0) return;

    const firstEl = focusableEls[0];
    const lastEl = focusableEls[focusableEls.length - 1];

    if (e.shiftKey) {
      if (document.activeElement === firstEl || document.activeElement === button) {
        e.preventDefault();
        lastEl.focus();
      }
    } else {
      if (document.activeElement === lastEl) {
        e.preventDefault();
        firstEl.focus();
      }
    }
  });
</script>

<style>
  .mobile-nav-item {
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
</style>
